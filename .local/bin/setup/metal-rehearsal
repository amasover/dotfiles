from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

CACHE = Path.home() / ".cache/bootstrap-harness"
ARTIFACT_ROOT = CACHE / "metal-rehearsal"
STAGES = (
    ("host-preflight", 900),
    ("prepare", 180),
    ("installer-boot", 180),
    ("install", 1800),
    ("first-boot", 240),
    ("handoff", 1200),
    ("reboot-proof", 300),
    ("hibernate-proof", 900),
    ("teardown", 120),
)
# Story 2.58: the fixed install becomes the booted workstation, which then
# builds a portable drive on a second disk; that drive alone boots afterwards.
HOST_SIDE_STAGES = (
    *STAGES[:5],
    ("host-install", 1800),
    ("drive-boot", 300),
    *STAGES[5:],
)
HOST_SIDE_HOSTNAME = "metal-usb"
PREALLOC_CEILING_SECONDS = 120
WORKING_SET_BYTES = 4 << 30
ANSI_ESCAPE = re.compile(
    rb"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[()][0-2A-Z]|[=>])"
)


class RehearsalError(RuntimeError):
    pass


def interrupted(signum, _frame):
    raise RehearsalError(f"interrupted by signal {signum}")


class PromptBuffer:
    """Consume only through a matched prompt; preserve fragmented and future input."""

    def __init__(self):
        self.data = b""

    def feed(self, data):
        # Leave incomplete escapes buffered until the next read completes them.
        self.data = ANSI_ESCAPE.sub(b"", self.data + data)

    def match(self, patterns):
        matches = [
            (m.start(), i, m)
            for i, pattern in enumerate(patterns)
            if (m := re.search(pattern, self.data)) is not None
        ]
        if not matches:
            # Bound noise, but retain enough context for every supported prompt.
            self.data = self.data[-65536:]
            return None
        _, index, match = min(matches, key=lambda item: (item[0], item[1]))
        self.data = self.data[match.end() :]
        return index, match


class Expect:
    def __init__(self, fd, deadline, log=None):
        self.fd = fd
        self.deadline = deadline
        self.log = log
        self.buffer = PromptBuffer()

    def send(self, text):
        data = text.encode()
        while data:
            count = os.write(self.fd, data)
            data = data[count:]

    def expect(self, *patterns, timeout=120):
        end = min(self.deadline(), time.monotonic() + timeout)
        while True:
            result = self.buffer.match(patterns)
            if result is not None:
                return result
            remaining = end - time.monotonic()
            if remaining <= 0:
                raise RehearsalError(f"timeout waiting for {patterns!r}")
            if not select.select([self.fd], [], [], remaining)[0]:
                continue
            try:
                chunk = os.read(self.fd, 65536)
            except OSError as exc:
                raise RehearsalError("terminal closed before expected prompt") from exc
            if not chunk:
                raise RehearsalError("terminal closed before expected prompt")
            if self.log:
                self.log.write(chunk)
                self.log.flush()
            self.buffer.feed(chunk)


def retained_artifacts(passed, keep):
    return not passed or keep


def destroy(path):
    """Only remove a completed harness-owned run, never an arbitrary path."""
    path = Path(path)
    if path.is_symlink() or path.resolve().parent != ARTIFACT_ROOT.resolve():
        raise RehearsalError(f"not a rehearsal directory: {path}")
    marker = path / "run.json"
    if not marker.is_file():
        raise RehearsalError(f"missing rehearsal ownership marker: {path}")
    metadata = json.loads(marker.read_text())
    if metadata.get("tool") != "metal-rehearsal":
        raise RehearsalError(f"not owned by metal-rehearsal: {path}")
    # An advisory lock survives stale metadata but prevents deleting a live run.
    with marker.open() as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RehearsalError("rehearsal is still running") from exc
        shutil.rmtree(path)
    print(f"Destroyed {path}")


def journal_gate(source, pattern, requirement):
    """Fail unless the journal carries a matching line and all of them satisfy it.

    The `n > 0` half is the non-vacuity guard: a gate that passes on an empty
    journal, or on a near-miss line that never carried the number being read,
    proves nothing. Anchor `pattern` on the value, not just the message.
    """
    return (
        f"journalctl {source} --no-pager | awk '"
        f"{pattern} {{ n++; if (!({requirement})) bad++ }}"
        " END { exit !(n > 0 && !bad) }'"
    )


class Rehearsal:
    def __init__(self, keep=False, portable=False, host_side=False):
        self.keep = keep
        # Portable mode (Story 2.57) installs over virtio, then boots the same
        # disk as USB mass storage with firmware variables holding no boot
        # entry: one run proves the fallback path and an initramfs carrying
        # drivers for a controller it never saw at install.
        self.portable = portable
        # Host-side mode (Story 2.58) builds that drive from the booted fixed
        # install instead of the ISO; the portable checks apply once it boots.
        self.host_side = host_side
        self.hostname = "metal-test"
        self.disk_bus = "virtio"
        self.usb_image = "drive.qcow2" if host_side else "disk.qcow2"
        self.root = Path(__file__).resolve().parents[3]
        self.path = None
        self.stage = "host-preflight"
        self.deadline = time.monotonic()
        self.vm = None
        self.serial = None
        self.monitor = None
        self.server = None
        self.logs = []
        self.user_password = secrets.token_hex(12)
        self.luks_password = secrets.token_hex(12)
        self.ssh = None
        self.ssh_fd = None
        self.lock = None

    def remaining(self):
        remaining = self.deadline - time.monotonic()
        if remaining <= 0:
            raise RehearsalError("stage deadline exceeded")
        return remaining

    def command(self, args, **kwargs):
        return subprocess.run(args, check=True, timeout=self.remaining(), **kwargs)

    def log(self, name):
        handle = (self.path / name).open("ab", buffering=0)
        self.logs.append(handle)
        return handle

    def pause(self, seconds):
        if self.remaining() < seconds:
            raise RehearsalError("stage deadline exceeded")
        time.sleep(seconds)

    def host_preflight(self):
        for name in ("qemu-system-x86_64", "qemu-img", "bsdtar", "ssh", "git"):
            if not shutil.which(name):
                raise RehearsalError(f"missing host command: {name}")
        if not os.access("/dev/kvm", os.R_OK | os.W_OK):
            raise RehearsalError("/dev/kvm must be readable and writable")
        firmware = Path("/usr/share/edk2/x64")
        self.code = firmware / "OVMF_CODE.4m.fd"
        self.vars = firmware / "OVMF_VARS.4m.fd"
        if not self.code.is_file() or not self.vars.is_file():
            raise RehearsalError(
                f"install edk2-ovmf: missing firmware under {firmware}"
            )
        ARTIFACT_ROOT.mkdir(parents=True, exist_ok=True)
        if shutil.disk_usage(ARTIFACT_ROOT).free < 10 * 1024**3:
            raise RehearsalError("need at least 10 GiB free under artifact root")
        self.iso = CACHE / "archlinux-x86_64.iso"
        sums = CACHE / "sha256sums.txt"
        if not self.iso.is_file() or not sums.is_file():
            self.command([str(self.root / ".local/bin/setup/vm-harness"), "fetch"])
        expected = next(
            (
                parts[0]
                for line in sums.read_text().splitlines()
                if len(parts := line.split()) == 2
                and parts[1].lstrip("*") == self.iso.name
            ),
            None,
        )
        with self.iso.open("rb") as handle:
            actual = hashlib.file_digest(handle, "sha256").hexdigest()
        if expected != actual:
            raise RehearsalError("cached ISO sha256 mismatch; run vm-harness fetch")
        print(f"ISO sha256 verified: {actual}", flush=True)

    def prepare(self):
        stamp = time.strftime("%Y%m%d-%H%M%S") + "-" + secrets.token_hex(3)
        self.path = ARTIFACT_ROOT / stamp
        self.path.mkdir(mode=0o700)
        self.lock = (self.path / "run.json").open("w+")
        fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        json.dump({"tool": "metal-rehearsal", "pid": os.getpid()}, self.lock)
        self.lock.flush()
        print(f"Artifacts: {self.path}", flush=True)
        # A portable layout reserves the 64 GiB resume ceiling plus the routine
        # swap and headroom that ceiling implies; qcow2 stays sparse either way.
        disks = {"disk.qcow2": "210G" if self.portable else "63G"}
        if self.host_side:
            disks["drive.qcow2"] = "210G"
        for name, size in disks.items():
            self.command(
                ["qemu-img", "create", "-f", "qcow2", str(self.path / name), size]
            )
        shutil.copyfile(self.vars, self.path / "OVMF_VARS.fd")
        entries = self.command(
            ["bsdtar", "-tf", str(self.iso)], capture_output=True, text=True
        ).stdout.splitlines()
        entry = next((p for p in entries if re.search(r"/01-.*\.conf$", p)), None)
        if entry is None:
            raise RehearsalError("ISO has no default loader entry")
        config = self.command(
            ["bsdtar", "-xOf", str(self.iso), entry], capture_output=True, text=True
        ).stdout
        fields = [
            parts
            for line in config.splitlines()
            if len(parts := line.split(maxsplit=1)) == 2
            and parts[0] in {"linux", "initrd", "options"}
        ]
        kernel = next((value for key, value in fields if key == "linux"), None)
        self.boot_options = next(
            (value for key, value in fields if key == "options"), None
        )
        uuid = next(
            (Path(p).stem for p in entries if re.fullmatch(r"boot/[^/]+\.uuid", p)),
            None,
        )
        if (
            not kernel
            or not self.boot_options
            or not uuid
            or not any(k == "initrd" for k, _ in fields)
        ):
            raise RehearsalError("ISO is missing kernel, initrd, options, or boot UUID")
        if f"archisosearchuuid={uuid}" not in self.boot_options.split():
            raise RehearsalError("ISO loader search UUID does not match boot/*.uuid")
        for filename, members in (
            ("vmlinuz", [kernel]),
            ("initrd.img", [v for k, v in fields if k == "initrd"]),
        ):
            with (self.path / filename).open("wb") as output:
                for member in members:
                    self.command(
                        ["bsdtar", "-xOf", str(self.iso), member.lstrip("/")],
                        stdout=output,
                    )
        public = self.path / "http"
        public.mkdir()
        paths = self.command(
            ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
            cwd=self.root,
            capture_output=True,
        ).stdout.split(b"\0")
        with tarfile.open(public / "tree.tar.gz", "w:gz") as archive:
            for raw in sorted(set(paths)):
                if not raw:
                    continue
                relative = os.fsdecode(raw)
                source = self.root / relative
                if source.exists() or source.is_symlink():
                    archive.add(source, arcname=relative, recursive=False)
        self.server = ThreadingHTTPServer(
            ("127.0.0.1", 0), partial(SimpleHTTPRequestHandler, directory=str(public))
        )
        threading.Thread(target=self.server.serve_forever, daemon=True).start()
        self.url = f"http://10.0.2.2:{self.server.server_port}/tree.tar.gz"
        # The installer pacstraps through this machine's ranked mirrorlist, as
        # a real workstation would: with reflector masked, the ISO's own list
        # leans on a single CDN, and one bad hour there fails every stage.
        shutil.copyfile("/etc/pacman.d/mirrorlist", public / "mirrorlist")
        self.mirrorlist = self.url.rsplit("/", 1)[0] + "/mirrorlist"
        with socket.socket() as sock:
            sock.bind(("127.0.0.1", 0))
            self.port = sock.getsockname()[1]

    def launch(self, installer=False):
        args = [
            "qemu-system-x86_64",
            "-machine",
            "q35,accel=kvm",
            "-cpu",
            "host",
            "-m",
            "8192",
            "-smp",
            "4",
            "-display",
            "none",
            "-no-reboot",
            "-drive",
            f"if=pflash,format=raw,readonly=on,file={self.code}",
            "-drive",
            f"if=pflash,format=raw,file={self.path / 'OVMF_VARS.fd'}",
            *self.disk_args(),
            "-netdev",
            f"user,id=net0,hostfwd=tcp:127.0.0.1:{self.port}-:22",
            "-device",
            "virtio-net-pci,netdev=net0",
            "-monitor",
            "stdio",
        ]
        if installer:
            args += [
                "-serial",
                "pty",
                "-cdrom",
                str(self.iso),
                "-kernel",
                str(self.path / "vmlinuz"),
                "-initrd",
                str(self.path / "initrd.img"),
                "-append",
                self.boot_options + " console=ttyS0 systemd.mask=reflector.service",
            ]
        else:
            args += ["-serial", f"file:{self.path / (self.stage + '-serial.log')}"]
        self.vm = subprocess.Popen(
            args,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            pass_fds=(self.lock.fileno(),),
        )
        self.monitor = Expect(self.vm.stdout.fileno(), lambda: self.deadline)
        if installer:
            _, match = self.monitor.expect(
                rb"char device redirected to (/dev/pts/\d+)", timeout=30
            )
            fd = os.open(match.group(1).decode(), os.O_RDWR | os.O_NOCTTY)
            tty.setraw(fd)
            self.serial = Expect(
                fd, lambda: self.deadline, self.log("installer-serial.log")
            )
        self.monitor.expect(rb"\(qemu\) ", timeout=30)

    def disk_args(self):
        if self.disk_bus == "virtio":
            names = ["disk.qcow2", "drive.qcow2"] if self.host_side else ["disk.qcow2"]
            return [
                argument
                for name in names
                for argument in (
                    "-drive",
                    f"if=virtio,format=qcow2,file={self.path / name}",
                )
            ]
        return [
            "-device",
            "qemu-xhci,id=xhci",
            "-drive",
            f"if=none,id=target,format=qcow2,file={self.path / self.usb_image}",
            "-device",
            "usb-storage,bus=xhci.0,drive=target,removable=on",
        ]

    def monitor_command(self, command):
        self.vm.stdin.write((command + "\n").encode())
        self.vm.stdin.flush()
        self.monitor.expect(rb"\(qemu\) ", timeout=30)

    def installer_boot(self):
        self.launch(installer=True)
        self.serial.expect(rb"login: ", timeout=150)
        self.serial.send("root\n")
        self.serial.expect(rb"root@archiso[^\r\n]*# ?", timeout=30)
        # Disable zsh spelling correction as its own line: zle is still
        # settling right after the first prompt, and a command joined to the
        # login line gets its first characters echoed garbled.
        self.serial.send("unsetopt correct\n")
        self.serial.expect(rb"root@archiso[^\r\n]*# ?", timeout=30)

    def install(self):
        self.serial.send(
            "mkdir -p /run/dotfiles; "
            f"curl -f {shlex.quote(self.mirrorlist)} -o /etc/pacman.d/mirrorlist && "
            f"curl -f {shlex.quote(self.url)} -o /run/tree.tar.gz && "
            "tar -xzf /run/tree.tar.gz -C /run/dotfiles && "
            "/run/dotfiles/.local/bin/setup/install-on-metal /dev/vda --hostname metal-test"
            + (" --portable" if self.portable else "")
            + "\n"
        )
        prompts = (
            (rb"Type WIPE /dev/vda to continue: ", "WIPE /dev/vda"),
            (rb"User password: ", self.user_password),
            (rb"Confirm user password: ", self.user_password),
            (rb"Disk encryption password: ", self.luks_password),
            (rb"Confirm disk encryption password: ", self.luks_password),
        )
        for prompt, answer in prompts:
            self.serial.expect(prompt, timeout=120)
            self.serial.send(answer + "\n")
        index, _ = self.serial.expect(
            rb"metal-provision: install failed",
            rb"metal-provision: install complete",
            timeout=1700,
        )
        if index == 0:
            raise RehearsalError("install failed; see installer serial log")
        self.serial.send("systemctl poweroff\n")
        # Keep draining the serial pty until shutdown so QEMU cannot block on it.
        try:
            self.serial.expect(rb"reboot: Power down", timeout=90)
        except RehearsalError:
            if self.vm.poll() is None:
                raise
        self.wait_vm()
        os.close(self.serial.fd)
        self.serial = None
        if self.portable:
            self.move_to_usb()

    def move_to_usb(self):
        # Another machine: a different storage controller and firmware that has
        # never seen this disk, so only the fallback path can boot it.
        shutil.copyfile(self.vars, self.path / "OVMF_VARS.fd")
        self.disk_bus = "usb"
        print(
            f"  portable: fresh firmware variables, {self.usb_image} moved to USB",
            flush=True,
        )

    def wait_vm(self):
        rc = self.vm.wait(timeout=self.remaining())
        self.vm.stdin.close()
        self.vm.stdout.close()
        self.vm = None
        if rc:
            raise RehearsalError(f"QEMU exited rc={rc}")

    def unlock(self):
        self.launch()
        self.pause(8)
        screenshot = self.path / (self.stage + "-menu.ppm")
        self.monitor_command(f"screendump {screenshot}")
        if not screenshot.is_file():
            raise RehearsalError("QEMU failed to save menu screendump")
        # USB enumeration and a driver-complete initramfs read through firmware
        # put the passphrase prompt later than on virtio; typed early, the keys
        # would land in the rEFInd menu instead.
        self.pause(67 if self.portable else 37)
        for character in self.luks_password:
            self.monitor_command(f"sendkey {character}")
            self.pause(0.08)
        self.monitor_command("sendkey ret")
        while True:
            self.remaining()
            if self.vm.poll() is not None:
                raise RehearsalError("QEMU exited before SSH became ready")
            try:
                with socket.create_connection(
                    ("127.0.0.1", self.port), timeout=2
                ) as sock:
                    sock.settimeout(2)
                    if sock.recv(64).startswith(b"SSH-"):
                        break
            except OSError:
                pass
            self.pause(2)

    def login(self):
        master, slave = pty.openpty()
        settings = termios.tcgetattr(slave)
        settings[3] &= ~termios.ECHO
        termios.tcsetattr(slave, termios.TCSANOW, settings)
        # Acquire a controlling terminal after exec, not in preexec_fn: the HTTP
        # server already has a thread, so Python work between fork/exec is unsafe.
        self.ssh = subprocess.Popen(
            [
                sys.executable,
                "-c",
                (
                    "import fcntl, os, sys, termios; "
                    "fcntl.ioctl(0, termios.TIOCSCTTY, 0); os.execvp(sys.argv[1], sys.argv[1:])"
                ),
                "ssh",
                "-tt",
                "-p",
                str(self.port),
                "-o",
                "StrictHostKeyChecking=accept-new",
                "-o",
                f"UserKnownHostsFile={self.path / 'known_hosts'}",
                "-o",
                "PubkeyAuthentication=no",
                "-o",
                "PreferredAuthentications=password",
                "-o",
                "NumberOfPasswordPrompts=1",
                "-o",
                "ConnectTimeout=10",
                "aaron@127.0.0.1",
                "sudo -p 'REHEARSAL-SUDO: ' -i",
            ],
            stdin=slave,
            stdout=slave,
            stderr=slave,
            start_new_session=True,
        )
        os.close(slave)
        self.ssh_fd = master
        self.shell = Expect(
            master, lambda: self.deadline, self.log(self.stage + "-ssh.log")
        )
        self.shell.expect(rb"[Pp]assword: ")
        self.shell.send(self.user_password + "\n")
        self.shell.expect(rb"REHEARSAL-SUDO: ")
        self.shell.send(self.user_password + "\n")
        self.shell.expect(rf"root@{self.hostname}[^\r\n]*# ?".encode())
        self.shell.send("stty -echo; export PS1='REHEARSAL# '; export TERM=dumb\n")
        self.shell.expect(rb"REHEARSAL# ")
        self.guest("id -u | grep -qx 0", "root-login")

    def guest(self, command, label):
        token = "RC-" + secrets.token_hex(6)
        # Run in a subshell: failure cannot kill the interactive shell or skip RC.
        self.shell.send(f"( set -e; {command}\n); printf '\\n{token}=%s\\n' \"$?\"\n")
        _, match = self.shell.expect(
            token.encode() + rb"=(\d+)\r?\n", timeout=self.remaining()
        )
        rc = int(match.group(1))
        print(f"  {label}: RC={rc}", flush=True)
        if rc:
            raise RehearsalError(f"{label} failed rc={rc}")

    def close_ssh(self):
        if self.ssh is not None:
            if self.ssh.poll() is None:
                self.ssh.terminate()
            try:
                self.ssh.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.ssh.kill()
                self.ssh.wait()
            self.ssh = None
        if self.ssh_fd is not None:
            os.close(self.ssh_fd)
            self.ssh_fd = None

    def unlock_and_login(self):
        self.unlock()
        self.login()

    def run_setup(self, *commands):
        for command in commands:
            self.guest("/root/dotfiles/.local/bin/setup/" + command, command)

    def first_boot(self):
        self.unlock_and_login()
        self.root_locked()

    def root_locked(self):
        """The recipe sets no root password; the wheel user administers via sudo."""
        self.guest('test "$(passwd -S root | cut -d" " -f2)" = L', "root-locked")

    def transfer_tree(self):
        self.guest(
            f"mkdir -p /root/dotfiles; curl -f {shlex.quote(self.url)} -o /root/tree.tar.gz; "
            "tar -xzf /root/tree.tar.gz -C /root/dotfiles",
            "working-tree-transfer",
        )

    def refused(self, arguments, message, label):
        """The installer exits 1 with message before any prompt; a prompt would hang."""
        self.guest(
            "rc=0; /root/dotfiles/.local/bin/setup/install-on-metal "
            f"{arguments} 2>/root/refusal || rc=$?; "
            f'test "$rc" -eq 1; grep -qF {shlex.quote(message)} /root/refusal',
            label,
        )

    def vars_digest(self):
        return hashlib.sha256((self.path / "OVMF_VARS.fd").read_bytes()).hexdigest()

    def host_install(self):
        """Build the portable drive from the booted guest, touching nothing else."""
        self.transfer_tree()
        drive = f"/dev/vdb --hostname {HOST_SIDE_HOSTNAME} --portable"
        self.refused(
            drive, "pacstrap (arch-install-scripts)", "missing-tools-named-first"
        )
        self.guest(
            "pacman -S --needed --noconfirm arch-install-scripts gptfdisk parted",
            "installer-tooling",
        )
        self.refused(
            f"/dev/vda --hostname {HOST_SIDE_HOSTNAME} --portable",
            "is mounted",
            "own-root-disk-refused",
        )
        self.refused(
            f"/dev/vdb --hostname {HOST_SIDE_HOSTNAME}",
            "firmware boot entry",
            "fixed-from-host-refused",
        )
        self.refused(
            "/dev/vdb --hostname metal-test --portable",
            "already exists",
            "host-volume-group-refused",
        )
        # A real workstation carries its own pacman hooks (this one's quarantine
        # gate aborts any transaction it cannot vet). They belong to the host:
        # pacstrap must not run them inside the target.
        self.guest(
            "mkdir -p /etc/pacman.d/hooks && printf '%s\\n' '[Trigger]' "
            "'Type = Package' 'Operation = Install' 'Target = *' '' '[Action]' "
            "'Description = host-only gate' 'When = PreTransaction' "
            "'Exec = /usr/bin/false' 'AbortOnFail' "
            "> /etc/pacman.d/hooks/00-host-only-gate.hook",
            "host-only-pacman-hook",
        )
        # Service credential mounts come and go with unrelated units.
        mounts = (
            "findmnt -rn -o TARGET,SOURCE,FSTYPE | grep -v '^/run/credentials/' | sort"
        )
        self.guest(f"{mounts} > /root/mounts.before", "host-mounts-recorded")
        firmware_before = self.vars_digest()
        token = "RC-" + secrets.token_hex(6)
        self.shell.send(
            f"/root/dotfiles/.local/bin/setup/install-on-metal {drive}; "
            f"printf '\\n{token}=%s\\n' \"$?\"\n"
        )
        for prompt, answer in (
            (rb"Type WIPE /dev/vdb to continue: ", "WIPE /dev/vdb"),
            (rb"User password: ", self.user_password),
            (rb"Confirm user password: ", self.user_password),
            (rb"Disk encryption password: ", self.luks_password),
            (rb"Confirm disk encryption password: ", self.luks_password),
        ):
            self.shell.expect(prompt, timeout=120)
            self.shell.send(answer + "\n")
        _, match = self.shell.expect(
            token.encode() + rb"=(\d+)\r?\n", timeout=self.remaining()
        )
        print(f"  host-side-install: RC={match.group(1).decode()}", flush=True)
        if match.group(1) != b"0":
            raise RehearsalError("host-side install failed; see host-install SSH log")
        if self.vars_digest() != firmware_before:
            raise RehearsalError("host-side install wrote firmware variables")
        print("  firmware-variables-unchanged: RC=0", flush=True)
        # LVM archives metadata under /etc/lvm, and pacman keeps its keyring,
        # databases, and cache under /etc and /var; none of them may move.
        self.guest(
            f"moved=$({mounts} | diff /root/mounts.before - || true); "
            "changed=$(find /etc /var/lib/pacman /var/cache/pacman "
            "-newer /root/mounts.before ! -path /etc/resolv.conf); "
            "left=$(dmsetup ls | grep -E 'metal--usb|metal-install' || true); "
            'printf "%s\\n" "$moved" "$changed" "$left"; '
            'test -z "$moved$changed$left"',
            "host-mounts-mappings-and-state-unchanged",
        )
        self.power_off()
        # The drive is another machine with its own host key on the same port.
        (self.path / "known_hosts").unlink(missing_ok=True)
        self.hostname = HOST_SIDE_HOSTNAME
        self.portable = True
        self.move_to_usb()

    def drive_boot(self):
        self.unlock_and_login()
        self.root_locked()

    def handoff(self):
        print(
            "  Guest prerequisites: stand-in for bootstrap step 9 (not full bootstrap)",
            flush=True,
        )
        self.guest(
            "pacman -Syu --needed --noconfirm intel-ucode python polkit",
            "guest-prerequisites",
        )
        self.guest(
            "runuser -u aaron -- sh -c 'cd /home/aaron; git clone https://aur.archlinux.org/refind-theme-nord.git; "
            "cd refind-theme-nord; makepkg --noconfirm'\n"
            "pacman -U --noconfirm /home/aaron/refind-theme-nord/*.pkg.tar.zst",
            "nord-package",
        )
        self.transfer_tree()
        self.run_setup(
            "refind-config audit",
            "refind-config apply",
            "refind-config --check",
            "hibernate-storage apply",
            "hibernate-storage --check",
            "refind-config apply",
        )
        self.guest(
            "grep -q 'resume=UUID=' /boot/refind_linux.conf; "
            'awk \'NR>1 {n++; if ($1=="/swapfile" && $2=="file" && $5==100) r++; '
            'if ($2=="partition" && $4==0 && $5==-1) h++} END {exit !(n==2 && r==1 && h==1)}\' /proc/swaps',
            "swap-layout-and-resume-option",
        )
        # Story 2.59: bootstrap's step links the tracked policy over the
        # installer's identical copy, and the image it builds is the systemd
        # chain with none of the udev-only hooks inert inside it.
        self.guest(
            "HOME=/root/dotfiles BOOTSTRAP_TEST_MODE=1 "
            "/root/dotfiles/.local/bin/setup/bootstrap --initramfs-hooks apply ''; "
            'test "$(readlink /etc/mkinitcpio.conf.d/10-dotfiles-hooks.conf)" = '
            "/root/dotfiles/.config/dotfiles/mkinitcpio/hooks.conf; "
            "mkinitcpio -P",
            "hooks-policy-linked",
        )
        self.guest(
            "lsinitcpio /boot/initramfs-linux.img > /root/image.lst; "
            "grep -qx 'usr/lib/systemd/systemd-cryptsetup' /root/image.lst; "
            "grep -qx 'usr/bin/busybox' /root/image.lst; "
            "! grep -qE '^hooks/(encrypt|resume|keymap|consolefont)$' /root/image.lst",
            "systemd-chain-image",
        )
        if self.portable:
            # Booting over USB already proved the USB drivers; nvme, which this
            # guest never had, proves autodetect stayed out of the rebuilt image.
            # rEFInd must live only on the fallback path refind-config manages.
            self.guest(
                "test -f /etc/mkinitcpio.conf.d/90-dotfiles-portable.conf; "
                "grep -qE '/nvme\\.ko' /root/image.lst; "
                "grep -qE '/usb-storage\\.ko' /root/image.lst; "
                "test -f /boot/EFI/BOOT/themes/nord/theme.conf; "
                "test ! -e /boot/EFI/refind",
                "portable-image-and-layout",
            )

    def reboot_proof(self):
        self.guest(
            "cat /proc/sys/kernel/random/boot_id > /root/pre-reboot-id; systemctl reboot",
            "reboot-request",
        )
        self.close_ssh()
        self.wait_vm()
        self.unlock_and_login()
        self.guest(
            'test "$(cat /root/pre-reboot-id)" != "$(cat /proc/sys/kernel/random/boot_id)"; '
            "grep -q 'resume=UUID=' /proc/cmdline; "
            "grep -q 'rd.luks.name=' /proc/cmdline; "
            "grep -qw 'SYSTEMD_SULOGIN_FORCE=1' /proc/cmdline; "
            "! grep -q 'cryptdevice=' /proc/cmdline",
            "reboot-and-kernel-resume",
        )
        self.run_setup("refind-config --check", "hibernate-storage --check")
        self.guest(
            "busctl call org.freedesktop.login1 /org/freedesktop/login1 "
            "org.freedesktop.login1.Manager CanHibernate | grep -qx 's \"yes\"'",
            "CanHibernate=yes",
        )

    # An idle guest hibernates in about a second whatever the drop-in does, so
    # it cannot tell a working preallocation path from a stalling one. Build a
    # working set, force it through zswap until the pool is populated, and only
    # then hibernate: that is the shape that regressed on real hardware.
    def hibernate_proof(self):
        self.guest(
            "/root/dotfiles/.config/dotfiles/hibernate/install",
            "prereclaim-installed",
        )
        # One random 1 MiB block repeated to WORKING_SET_BYTES. Zswap compresses
        # each page on its own, so the repetition costs nothing, while a zeroed
        # buffer would store as same-filled entries that occupy no pool.
        self.guest(
            "printf 'Y\\n' > /sys/module/zswap/parameters/enabled; "
            "setsid python -c \"import os, signal;"
            f"buf = os.urandom(1 << 20) * {WORKING_SET_BYTES >> 20};"
            "open('/run/loadgen.pid', 'w').write(str(os.getpid()));"
            'signal.pause()" &\n'
            "until [ -s /run/loadgen.pid ]; do sleep 1; done",
            "working-set-resident",
        )
        self.guest(
            "echo 2G > /sys/fs/cgroup/memory.reclaim; "
            "awk '$1 == \"Zswap:\" { exit !($2 > 0) }' /proc/meminfo",
            "zswap-pool-populated",
        )
        marker = secrets.token_hex(24)
        self.guest(
            f"printf '%s' {marker} > /dev/shm/metal-rehearsal; "
            "cat /proc/sys/kernel/random/boot_id > /root/pre-hibernate-id; "
            "systemctl hibernate",
            "hibernate-request",
        )
        self.close_ssh()
        self.wait_vm()
        self.unlock_and_login()
        self.guest(
            f'test "$(cat /dev/shm/metal-rehearsal)" = {marker}; '
            'test "$(cat /root/pre-hibernate-id)" = "$(cat /proc/sys/kernel/random/boot_id)"; '
            'kill -0 "$(cat /run/loadgen.pid)"; '
            "journalctl -b -k --no-pager | grep -qi 'PM: hibernation: hibernation exit'",
            "resumed-session",
        )
        # The contract is a cheap frozen phase, not a drained pool: writeback
        # never triggers during this reclaim, and target_kb already charges the
        # pool against the eviction target. Assert that measured memory left
        # RAM, so a future no-op cannot pass on a machine fast enough to clear
        # the ceiling anyway. A shortfall still passes: the helper reports what
        # moved rather than what it asked for, and moving less than the target
        # is slow, not broken.
        self.guest(
            journal_gate(
                "-b -u systemd-hibernate.service",
                "/hibernate-prereclaim: evicted [0-9]+ of [0-9]+ kB;/",
                'substr($0, index($0, "evicted ") + 8) + 0 > 0',
            ),
            "eviction-moved-memory",
        )
        # Emitted while userspace was frozen, so journald only records it after
        # the resume above; give it a moment to catch up on the ring buffer.
        # Wait and gate both match the timing line specifically: preallocation
        # also logs an "Allocated N pages" line carrying no duration, and
        # accepting that would let a kernel which stopped reporting the speed
        # pass the one stage that exists to read it.
        self.guest(
            "for _ in $(seq 30); do "
            "journalctl -b -k --no-pager"
            " | grep -q 'hibernation: Allocated .* in .* seconds' && break; "
            "sleep 1; done; "
            + journal_gate(
                "-b -k",
                "/hibernation: Allocated .* in .* seconds/",
                f'substr($0, index($0, " in ") + 4) + 0 <= {PREALLOC_CEILING_SECONDS}',
            ),
            "preallocation-under-ceiling",
        )

    def teardown(self):
        self.power_off()

    def power_off(self):
        """Close SSH, then press the ACPI power button through the monitor.

        A poweroff typed into the session can be lost: closing the session
        right after sending it can hang up the shell before it reads the line,
        and the guest then runs on to the stage deadline. QEMU exiting within
        the deadline is the success signal.
        """
        self.close_ssh()
        self.monitor_command("system_powerdown")
        self.wait_vm()

    def print_tail(self, pattern, label):
        """Name the channel even when it captured nothing: silence reads as a bug."""
        logs = sorted(
            (p for p in self.path.glob(pattern) if p.stat().st_size),
            key=lambda p: p.stat().st_mtime,
        )
        if not logs:
            print(f"--- no {label} output captured ---", file=sys.stderr)
            return
        newest = logs[-1]
        print(f"--- last 40 {label} lines ({newest.name}) ---", file=sys.stderr)
        with newest.open(errors="replace") as handle:
            print("".join(deque(handle, maxlen=40)), file=sys.stderr)

    def finish(self, passed):
        self.close_ssh()
        if self.vm is not None:
            self.vm.terminate()
            try:
                self.vm.wait(timeout=10)
            except subprocess.TimeoutExpired:
                self.vm.kill()
                self.vm.wait()
        if self.serial is not None:
            os.close(self.serial.fd)
        if self.server:
            self.server.shutdown()
            self.server.server_close()
        for handle in self.logs:
            handle.close()
        if not self.path:
            print(f"Artifact root: {ARTIFACT_ROOT} (no guest created)", flush=True)
            return
        if retained_artifacts(passed, self.keep):
            credentials = self.path / "credentials.json"
            with os.fdopen(
                os.open(credentials, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w"
            ) as handle:
                json.dump(
                    {
                        "user": "aaron",
                        "user_password": self.user_password,
                        "luks_password": self.luks_password,
                    },
                    handle,
                )
            if not passed:
                self.print_tail("*-serial.log", "serial")
                self.print_tail("*-ssh.log", "SSH")
            print(f"Kept artifacts: {self.path}", flush=True)
        if self.lock:
            self.lock.close()
        if not retained_artifacts(passed, self.keep):
            destroy(self.path)

    def run(self):
        passed = False
        try:
            for stage, timeout in HOST_SIDE_STAGES if self.host_side else STAGES:
                self.stage = stage
                self.deadline = time.monotonic() + timeout
                print(f"==> {stage} (timeout {timeout}s)", flush=True)
                getattr(self, stage.replace("-", "_"))()
                print(f"=== {stage} PASS", flush=True)
            passed = True
            return 0
        except (
            RehearsalError,
            OSError,
            ValueError,
            subprocess.SubprocessError,
            KeyboardInterrupt,
        ) as exc:
            print(
                f"metal-rehearsal: FAIL stage={self.stage}: {exc}",
                file=sys.stderr,
                flush=True,
            )
            return 1
        finally:
            self.finish(passed)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    run = commands.add_parser(
        "run", help="install, boot, reconcile, reboot, hibernate, resume"
    )
    run.add_argument(
        "--keep",
        action="store_true",
        help="keep artifacts and throwaway credentials even on pass",
    )
    run.add_argument(
        "--portable",
        action="store_true",
        help="install --portable, then boot the disk over USB with fresh firmware",
    )
    run.add_argument(
        "--host-side",
        action="store_true",
        help="build a portable drive from the booted fixed install, then boot it",
    )
    remove = commands.add_parser(
        "destroy", help="remove one retained, inactive rehearsal directory"
    )
    remove.add_argument("path", type=Path)
    args = parser.parse_args(argv)
    if args.command == "run":
        return Rehearsal(args.keep, args.portable, args.host_side).run()
    try:
        destroy(args.path)
    except (RehearsalError, OSError, ValueError) as exc:
        parser.exit(1, f"metal-rehearsal: {exc}\n")
    return 0


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    sys.exit(main())
