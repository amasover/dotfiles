#!/usr/bin/env python3
"""Rehearse the attended metal install, handoff, and hibernate on user-owned QEMU.

Local integration gate for provision-seed, refind-config, and hibernate-storage.
No host elevation, libvirt, guest prompt bypass, or full bootstrap is involved.
"""

