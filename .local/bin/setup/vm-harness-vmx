#!/usr/bin/env python3
"""vm-harness-vmx — .vmx authoring for the VMware harness (2.36, #119).

Generates the VM definition the way the libvirt harness's virt-install call
does, translated to VMware (Workstation on Windows, Fusion on an Apple-silicon
Mac — `--arch` picks the hardware table): UEFI firmware (systemd-boot needs
it — the bash harness learned this from the retired legacy-BIOS win10 VM),
NVMe disk (the seed's archinstall config targets /dev/nvme0n1), two SATA CD
drives (arch ISO + NoCloud seed), NAT nic, and a serial port logging to a
file — the install phase's observability channel, since VMware has no
direct-kernel-boot serial trick.

`eject` rewrites the vmx so later boots hit the disk: with the ISO still
attached, the EFI firmware would boot the installer again instead of the
installed system — the Workstation equivalent of the bash harness's
"media ejected so later boots hit the disk". `media` reports that state
(attached|ejected) so the driver never parses vmx internals itself.

`resume` is the pipeline's resume-point decision table (the bash harness's
"probe live state only" design, #98): the driver gathers the facts, this
answers where `up` starts — or refuses (dead-install / install-running),
because `up` never destroys and never re-runs a died install unasked.

`ports-iso` picks the archiso-aarch64 ISO and its published sha256 out of a
Codeberg release (JSON on stdin) for the macOS driver's `fetch`, which keeps
the download and the hash check against the file.

Logic is pure (text in/text out); only main() touches files. Tests:
tests/test_vm_harness_vmx.py.
"""

import argparse
import json
import re
import sys
from pathlib import Path


# Per-architecture hardware. x86_64 is the Workstation (Windows host) VM and
# stays exactly as validated there; aarch64 is the Fusion (Apple-silicon Mac)
# VM. Fusion runs arm64 guests only, and its arm platform has no PS/2 or
# vmmouse — keyboard and mouse are USB devices on the XHCI controller, which
# Broadcom KB 315602 names as the supported arm input path (EHCI/UHCI "not
# fully supported"). guestOS/virtualHW were read off a scratch VM made by
# Fusion 26H1's own `vmcli VM Create` (virtualHW 22); the 7.x id comes from
# the same build's guest table ("Other Linux 7.x and later kernel 64-bit
# Arm") because the Ports kernel is 7.x.
#
# "extra" holds the keys only one architecture writes, appended after the
# shared set in this order.
ARCH_HW = {
    "x86_64": {"virtualHW": "21", "guestOS": "other6xlinux-64", "usb": "FALSE",
               "extra": []},
    "aarch64": {
        "virtualHW": "22", "guestOS": "arm-other7xlinux-64", "usb": "TRUE",
        "extra": [
            ("usb_xhci.present", "TRUE"),
            # Multi-monitor ("Use All Displays in Full Screen") depends on SVGA
            # autodetect, which is on by default — pinned so a hand edit can't
            # silently cap it. At power-on Fusion sizes the display memory
            # from the host's display topology (vmware.log, 2026-11-02:
            # "SVGA-GFB: Max wh(6688, 5016), number of displays: 10", then
            # writes svga.vramSize itself); the guest's vmwgfx screen-target
            # unit exposes Virtual-1..8 connectors. Fixed svga.maxWidth/
            # maxHeight/numDisplays/vramSize would only cap that, so none are
            # set. The rest is guest-side: vmtoolsd running (Fusion refuses
            # multimon otherwise — "must have up-to-date VMware Tools").
            ("svga.autodetect", "TRUE"),
            # 3D memory (the GUI's "Shared graphics memory"): Fusion's default
            # is 256 MiB (same log), and the Mac panel plus two 4K heads take
            # ~100 MiB of that as bare 32-bpp framebuffers. 2 GiB leaves room
            # for compositor and WebRender surfaces; verified honoured live
            # (vmware.log: "SVGA: graphicsMemoryKB=2097152").
            ("svga.graphicsMemoryKB", "2097152"),
            # Fusion's sound default is es1371, which the arm vmx refuses at
            # power-on ("es1371 is not valid device type for sound"); hdaudio
            # powers on and binds the host's default output and input
            # (scratch VM, 2026-11-03). The guest driver is snd-hda-intel.
            ("sound.virtualDev", "hdaudio"),
            # The Mac's camera as a virtual UVC device ("Add Device > Camera"
            # in the GUI, Fusion Pro 26H1 guide): Fusion streams the host's
            # default AVCapture camera into it. Port 5 is the one Fusion
            # leaves free beside its own HID (4) and hubs (6, 7).
            ("usb_xhci:5.present", "TRUE"),
            ("usb_xhci:5.deviceType", "video"),
            ("usb_xhci:5.port", "5"),
            ("usb_xhci:5.parent", "-1"),
        ],
    },
}


def build_vmx(
    *, name: str, disk: str, iso: str, seed_iso: str, serial_log: str,
    ram_mib: int, cpus: int, arch: str = "x86_64",
) -> str:
    hw = ARCH_HW[arch]
    entries = [
        (".encoding", "UTF-8"),
        ("config.version", "8"),
        ("virtualHW.version", hw["virtualHW"]),
        ("displayName", name),
        ("guestOS", hw["guestOS"]),
        ("firmware", "efi"),
        # Without this the guest exposes only legacy SVGA and Mesa falls back
        # to llvmpipe; Firefox hardware WebRender needs SVGA3D (5.7, #189).
        ("mks.enable3d", "TRUE"),
        ("memsize", str(ram_mib)),
        ("numvcpus", str(cpus)),
        # PCIe root ports: NVMe and vmxnet3 are PCIe devices and need slots on
        # modern virtualHW — without these, power-on dies with
        # "[msg.pci.noslotavail] No PCIe slot available for Ethernet0".
        ("pciBridge0.present", "TRUE"),
        ("pciBridge4.present", "TRUE"),
        ("pciBridge4.virtualDev", "pcieRootPort"),
        ("pciBridge4.functions", "8"),
        ("pciBridge5.present", "TRUE"),
        ("pciBridge5.virtualDev", "pcieRootPort"),
        ("pciBridge5.functions", "8"),
        ("pciBridge6.present", "TRUE"),
        ("pciBridge6.virtualDev", "pcieRootPort"),
        ("pciBridge6.functions", "8"),
        ("pciBridge7.present", "TRUE"),
        ("pciBridge7.virtualDev", "pcieRootPort"),
        ("pciBridge7.functions", "8"),
        ("nvme0.present", "TRUE"),
        ("nvme0:0.present", "TRUE"),
        ("nvme0:0.fileName", disk),
        ("sata0.present", "TRUE"),
        ("sata0:0.present", "TRUE"),
        ("sata0:0.deviceType", "cdrom-image"),
        ("sata0:0.fileName", iso),
        ("sata0:1.present", "TRUE"),
        ("sata0:1.deviceType", "cdrom-image"),
        ("sata0:1.fileName", seed_iso),
        ("ethernet0.present", "TRUE"),
        ("ethernet0.connectionType", "nat"),
        # vmxnet3: paravirtual nic, driver in mainline (archiso has it) — the
        # virtio-net analog; e1000e emulation is the slow fallback.
        ("ethernet0.virtualDev", "vmxnet3"),
        ("ethernet0.addressType", "generated"),
        ("serial0.present", "TRUE"),
        ("serial0.fileType", "file"),
        ("serial0.fileName", serial_log),
        ("serial0.tryNoRxLoss", "TRUE"),
        # The guest runs UTC (seed config); VMware's virtual RTC follows the
        # host's local time unless pinned — pin it or the guest clock lands
        # hours off and pacman TLS/signature checks get weird.
        ("rtc.diffFromUTC", "0"),
        ("tools.syncTime", "FALSE"),
        # Headless runs must never block on a dialog.
        ("msg.autoAnswer", "TRUE"),
        # Workstation's sound device is on by default and covers Linux guests
        # (Workstation Pro 26H1 guide, "Virtual Machine Sound Support"); the
        # card type is left to each product's guest-OS default except where
        # that default fails (aarch64: see ARCH_HW).
        ("sound.present", "TRUE"),
        ("usb.present", hw["usb"]),
        # VMware presents a floppy controller unless told otherwise; the guest
        # kernel probes the empty drive and logs "I/O error, dev fd0" on every
        # boot (seen after the 26H1 upgrade, 2026-08-21).
        ("floppy0.present", "FALSE"),
        ("vmci0.present", "TRUE"),
    ] + hw["extra"]
    return "".join(f'{k} = "{v}"\n' for k, v in entries)


def eject_media(vmx_text: str) -> str:
    """Detach both CD drives (installer + seed) so the next boot hits the disk.
    Idempotent: already-FALSE lines stay FALSE."""
    return re.sub(
        r'^(sata0:[01]\.present) = "TRUE"$',
        r'\1 = "FALSE"',
        vmx_text,
        flags=re.MULTILINE,
    )


def media_state(vmx_text: str) -> str:
    """'attached' while the installer CD is wired in, else 'ejected' — the
    driver's installed-state probe. An absent sata0:0.present line counts as
    ejected (VMware rewrites the vmx at power-on and owns the format)."""
    if re.search(r'^sata0:0\.present = "TRUE"$', vmx_text, flags=re.MULTILINE):
        return "attached"
    return "ejected"


def resume_point(*, media: str, disk_exists: bool, seed_exists: bool,
                 serial_log_exists: bool, running: bool) -> str:
    """Where `up` (re)starts, from live state only. media='absent' means no
    vmx. The serial log only exists once a power-on happened, so with media
    still attached it separates install-never-ran from dead-install (under
    VMware `create` writes the vmx, so unlike libvirt its existence proves
    nothing about install). The seed stops mattering once media is ejected."""
    if media == "absent" or not disk_exists:
        return "create"
    if media == "attached":
        if not seed_exists:
            return "create"
        if running:
            return "install-running"
        if serial_log_exists:
            return "dead-install"
        return "install"
    return "bootstrap" if running else "boot"


def generated_mac(vmx_text: str) -> str | None:
    """The nic MAC VMware wrote at first power-on (addressType generated) —
    the key into the vmnet DHCP leases file."""
    m = re.search(r'^ethernet0\.generatedAddress = "([0-9A-Fa-f:]+)"$',
                  vmx_text, flags=re.MULTILINE)
    return m.group(1).lower() if m else None


# archiso-aarch64 ships one ISO per Codeberg release, hosted off-site, with no
# checksum asset: the sha256 sits in the release notes as `<hex>  <name>`.
PORTS_ISO_NAME = re.compile(r"^archlinux-\d{4}\.\d{2}\.\d{2}-aarch64\.iso$",
                            re.IGNORECASE)


def ports_iso(release: dict) -> tuple[str, str, str]:
    """Pick the ISO asset out of a Codeberg release (the API's JSON object)
    and the sha256 its notes publish for it: (name, url, sha256). Raises
    ValueError naming the gap. The hash must sit next to the exact asset
    name — the 2026-08-03 notes listed other build dates than their assets,
    so a near-match must not pass. Both come from the same release, so this
    catches a bad download or a swapped bucket object, not a compromised
    release."""
    tag = release.get("tag_name") or ""
    assets = [a for a in release.get("assets") or []
              if PORTS_ISO_NAME.search(a.get("name") or "")]
    if len(assets) != 1:
        raise ValueError(f"release {tag}: expected one "
                         f"archlinux-<date>-aarch64.iso asset, found {len(assets)}")
    name = assets[0]["name"]
    m = re.search(rf"([0-9a-fA-F]{{64}})\s+{re.escape(name)}",
                  release.get("body") or "")
    if not m:
        raise ValueError(f"release {tag} publishes no sha256 for {name}")
    return name, assets[0].get("browser_download_url") or "", m.group(1)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="vm-harness-vmx", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    gen = sub.add_parser("generate", help="write a fresh .vmx")
    gen.add_argument("--out", required=True)
    gen.add_argument("--name", default="arch-harness")
    gen.add_argument("--disk", required=True)
    gen.add_argument("--iso", required=True)
    gen.add_argument("--seed-iso", required=True)
    gen.add_argument("--serial-log", required=True)
    gen.add_argument("--ram", type=int, default=12288, metavar="MIB")
    gen.add_argument("--cpus", type=int, default=16)
    gen.add_argument("--arch", choices=sorted(ARCH_HW), default="x86_64",
                     help="guest architecture (Fusion on Apple silicon: aarch64)")

    ej = sub.add_parser("eject", help="detach installer + seed media in place")
    ej.add_argument("--vmx", required=True)

    med = sub.add_parser("media", help="print attached|ejected")
    med.add_argument("--vmx", required=True)

    res = sub.add_parser("resume", help="print the phase `up` resumes at")
    res.add_argument("--media", required=True,
                     choices=["absent", "attached", "ejected"])
    for flag in ("--disk", "--seed", "--serial-log", "--running"):
        res.add_argument(flag, required=True, choices=["yes", "no"])

    mac = sub.add_parser("mac", help="print the generated nic MAC")
    mac.add_argument("--vmx", required=True)

    sub.add_parser("ports-iso", help="read a Codeberg release (JSON) on stdin; "
                   "print the ISO's name, release name, url and sha256, one per line")

    args = ap.parse_args(argv)
    if args.cmd == "generate":
        text = build_vmx(
            name=args.name, disk=args.disk, iso=args.iso, seed_iso=args.seed_iso,
            serial_log=args.serial_log, ram_mib=args.ram, cpus=args.cpus,
            arch=args.arch,
        )
        Path(args.out).write_text(text, newline="\n")
        print(args.out)
    elif args.cmd == "eject":
        p = Path(args.vmx)
        p.write_text(eject_media(p.read_text()), newline="\n")
        print("media ejected")
    elif args.cmd == "media":
        print(media_state(Path(args.vmx).read_text()))
    elif args.cmd == "resume":
        print(resume_point(
            media=args.media, disk_exists=args.disk == "yes",
            seed_exists=args.seed == "yes",
            serial_log_exists=args.serial_log == "yes",
            running=args.running == "yes"))
    elif args.cmd == "mac":
        m = generated_mac(Path(args.vmx).read_text())
        if not m:
            print("no generatedAddress yet (VM never powered on?)", file=sys.stderr)
            return 1
        print(m)
    elif args.cmd == "ports-iso":
        try:
            release = json.load(sys.stdin.buffer)
            name, url, sha256 = ports_iso(release)
        except ValueError as e:  # json.JSONDecodeError is one too
            print(e, file=sys.stderr)
            return 1
        print(name, release.get("name") or "", url, sha256, sep="\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
