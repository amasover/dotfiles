#!/bin/bash
# vm-harness-guest — guest-side glue shared by both vm-harnesses (2.36, #119).
#
# Runs INSIDE the throwaway Arch guest, delivered by the harness at bootstrap
# time (scp/ssh), so the guest always executes the host checkout's version.
# Extracted from the libvirt harness's inline ssh strings; both the QEMU and
# VMware harnesses now copy and invoke this file for bootstrap/check.
#
# Subcommands:
#   bootstrap --class C --repo URL [--branch B]
#              clone/refresh yadm, select the concrete machine class, ensure an
#              empty machine-local group exists, then run bootstrap check+apply
#   check      assert the end state: no unmanaged packages beyond the custom
#              PKGBUILDs' expected vendored set, service samples, drift report
#
# Hardware packages come only from the class's tracked adapter group (Story
# 2.30). This helper never injects them into machine-local.toml.
set -euo pipefail
tools_dir=${VM_HARNESS_GUEST_TOOLS_DIR:-$HOME/.local/bin/tools}

say() { printf '\n==> %s\n' "$*"; }
die() {
    printf 'vm-harness-guest: FATAL: %s\n' "$*" >&2
    exit 2
}

# Guard a flag that takes a value: `need "$@"` before reading $2, so a
# dangling `--class` dies with the usual message instead of tripping `set -u`.
need() { (($# >= 2)) || die "$1 needs a value"; }

usage() { sed -n '2,/^set -euo/{/^set -euo/d; s/^# \{0,1\}//p;}' "$0"; }

write_empty_machine_local() {
    printf '# machine-local metapac group — untracked, never published\n'
    printf '# concrete class adapters own all guest hardware packages (Story 2.30)\n'
    printf '[arch]\npackages = [\n]\n'
}

cmd_bootstrap() {
    local class='' repo='' branch='' current_branch ml
    while (($#)); do
        case $1 in
            --class)
                need "$@"
                class=$2
                shift 2
                ;;
            --repo)
                need "$@"
                repo=$2
                shift 2
                ;;
            --branch)
                need "$@"
                branch=$2
                shift 2
                ;;
            *) die "bootstrap: unknown argument '$1'" ;;
        esac
    done
    [[ -n "$class" && -n "$repo" ]] \
        || die 'bootstrap needs --class and --repo'
    sudo pacman -S --needed --noconfirm git base-devel yadm
    # Clone, or refresh an existing checkout. A resumed guest cannot rely on
    # `yadm clone || true`: that silently keeps converging the first branch.
    # A live miss proved it: on 2026-08-13 a resumed run built a package
    # main had already removed. --ff-only makes surprise divergence fail
    # loudly instead of merging something nobody asked for.
    #
    # A resumed guest must also honour a CHANGED --branch: the harness
    # advertises VM_HARNESS_BRANCH as the way to validate guest-side bootstrap
    # changes pre-merge, and a refresh arm that only fast-forwarded whatever
    # was cloned first would keep testing the old branch — the same stale
    # checkout bug one level up. Fetch, switch if asked, then fast-forward.
    if yadm rev-parse --git-dir >/dev/null 2>&1; then
        echo "==> Refreshing the existing yadm checkout"
        yadm fetch --prune origin
        current_branch=$(yadm rev-parse --abbrev-ref HEAD)
        if [[ -n "$branch" && "$current_branch" != "$branch" ]]; then
            echo "==> Switching the checkout to '$branch'"
            yadm checkout "$branch"
            current_branch=$branch
        fi
        [[ -n "$current_branch" && "$current_branch" != HEAD ]] \
            || die 'existing yadm checkout has no branch to fast-forward'
        yadm merge --ff-only "origin/$current_branch"
    else
        yadm clone --no-bootstrap ${branch:+-b "$branch"} "$repo"
    fi
    ml="$HOME/.local/share/metapac/machine-local.toml"
    yadm config local.class "$class"
    yadm alt
    mkdir -p "${ml%/*}"
    if [[ ! -e $ml ]] || grep -q '^# harness-owned guest hardware set' "$ml"; then
        write_empty_machine_local >"$ml"
    fi
    "$HOME/.local/bin/setup/bootstrap" --check --unattended
    "$HOME/.local/bin/setup/bootstrap" --unattended
}

cmd_check() {
    local out rc=0 names='' vendored='' real=''
    echo '--- unmanaged packages (vendored custom PKGBUILDs are expected):'
    # metapac's own failure must not look like the gate finding drift: with
    # `2>/dev/null` and set -e this died silently, and the host only saw
    # "guest command failed (rc=127)". Keep stderr, report the rc.
    out=$(metapac unmanaged) || rc=$?
    ((rc == 0)) || die "metapac unmanaged failed (rc=$rc) — the gate did not run"
    if [[ -n "$out" ]]; then
        names=$(printf '%s\n' "$out" | "$tools_dir/metapac-unmanaged-names") \
            || die 'could not parse metapac unmanaged output'
    fi
    vendored=$("$tools_dir/custom-pkgs" list) \
        || die 'could not list vendored packages'
    real=$(comm -23 \
        <(printf '%s\n' "$names" | sed '/^$/d' | sort -u) \
        <(printf '%s\n' "$vendored" | sed '/^$/d' | sort -u))
    if [[ -z "$real" ]]; then
        echo OK
    else
        printf '%s\n' "$real"
        exit 1
    fi
    echo '--- enabled services (sample):'
    systemctl is-enabled sshd NetworkManager 2>/dev/null || true
    echo '--- graphical target reachable:'
    systemctl status graphical.target --no-pager | head -3 || true
    echo '--- drift report:'
    "$tools_dir/metapac-drift-report"
}

case "${1:-}" in
    bootstrap)
        shift
        cmd_bootstrap "$@"
        ;;
    check) cmd_check ;;
    '' | help)
        usage
        [[ "${1:-}" == help ]] || exit 2
        ;;
    *) die "unknown subcommand '$1'" ;;
esac
