#!/bin/bash
# vm-harness-guest — guest-side glue shared by both vm-harnesses (2.36, #119).
#
# Runs INSIDE the throwaway Arch guest, delivered by the harness at bootstrap
# time (scp/ssh), so the guest always executes the host checkout's version.
# Extracted from the libvirt harness's inline ssh strings; both the QEMU and
# VMware harnesses now copy and invoke this file for bootstrap/check.
#
# Subcommands:
#   bootstrap --class C --repo URL [--branch B] [--attended]
#              clone/refresh yadm, select the concrete machine class, ensure an
#              empty machine-local group exists, then run bootstrap check+apply
#              (--unattended). --attended is the first bootstrap of a real VM
#              (Story 5.8), run over `ssh -t`: everything a person types comes
#              first, then the long run needs nobody. It asks for the user's
#              sudo password once (sudo -v) and installs a temporary
#              password-free sudo drop-in (/etc/sudoers.d/89-first-bootstrap)
#              that a trap deletes when the run ends (success, failure,
#              Ctrl-C, hangup, TERM); then `yadm decrypt` asks for the archive
#              passphrase (3 attempts; skipped once ~/.zshenv exists). Then it
#              runs the same bootstrap check+apply --unattended as every
#              disposable run, and ends by printing the follow-ups that
#              --unattended skipped.
#   check --class C
#              assert the selected class/adapter/inbox, package drift, services;
#              fails first if the temporary sudo drop-in is still there
# Hardware packages come only from the class's tracked adapter group (Story
# 2.30). This helper never injects them into machine-local.toml.
set -euo pipefail
tools_dir=${VM_HARNESS_GUEST_TOOLS_DIR:-$HOME/.local/bin/tools}
# Test seam: the sudoers include dir (sudo ignores names containing a dot, so
# the staging copy below is inert until it is renamed into place).
sudoers_dir=${VM_HARNESS_GUEST_SUDOERS_DIR:-/etc/sudoers.d}
dropin=$sudoers_dir/89-first-bootstrap
dropin_staging=$sudoers_dir/.89-first-bootstrap.new

say() { printf '\n==> %s\n' "$*"; }
die() {
    printf 'vm-harness-guest: FATAL: %s\n' "$*" >&2
    exit 2
}

# Guard a flag that takes a value: `need "$@"` before reading $2, so a
# dangling `--class` dies with the usual message instead of tripping `set -u`.
need() { (($# >= 2)) || die "$1 needs a value"; }

usage() { sed -n '2,/^set -euo/{/^set -euo/d; s/^# \{0,1\}//p;}' "$0"; }

write_empty_machine_local() {
    printf '# machine-local metapac group — untracked, never published\n'
    printf '# concrete class adapters own all guest hardware packages (Story 2.30)\n'
    printf '[arch]\npackages = [\n]\n'
}

migrate_legacy_machine_local() {
    local file=$1 tmp
    tmp=$(mktemp "${file}.tmp.XXXXXX")
    awk '
        /^# harness-owned guest hardware set/ {
            print "# concrete class adapters own all guest hardware packages (Story 2.30)"
            next
        }
        /^# \(interim home until the Story 2[.]30 class\/hardware split, #96\)$/ { next }
        /^[[:space:]]*"(open-vm-tools|qemu-guest-agent|zram-generator)",?[[:space:]]*(#.*)?$/ { next }
        { print }
    ' "$file" >"$tmp" || {
        rm -f "$tmp"
        return 1
    }
    chmod --reference="$file" "$tmp"
    mv "$tmp" "$file"
}

# /etc/sudoers.d is root-only (0750), so existence is asked through sudo. -n
# never prompts: while the drop-in exists sudo needs no password and the test
# answers; once it is gone a real VM's user needs one, -n fails, and that
# counts as absent too.
dropin_present() { sudo -n test -e "$dropin" 2>/dev/null; }

# Written to a temp file, checked by visudo, staged under a dotted name and
# renamed: a half-written file in sudoers.d would break sudo for everyone.
install_sudo_dropin() {
    local tmp
    tmp=$(mktemp)
    printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$(id -un)" >"$tmp"
    if ! sudo visudo -cf "$tmp" >/dev/null; then
        rm -f "$tmp"
        die 'visudo rejected the temporary sudo drop-in — nothing installed'
    fi
    sudo install -m 0440 "$tmp" "$dropin_staging"
    rm -f "$tmp"
    sudo mv -f "$dropin_staging" "$dropin"
    echo "==> Temporary password-free sudo for this run: $dropin (deleted when the run ends)"
}

remove_sudo_dropin() {
    dropin_present || sudo -n test -e "$dropin_staging" 2>/dev/null || return 0
    sudo -n rm -f "$dropin" "$dropin_staging" 2>/dev/null || true
    if dropin_present; then
        printf 'vm-harness-guest: WARNING: could not delete %s — delete it now: sudo rm %s\n' \
            "$dropin" "$dropin" >&2
        return 1
    fi
    echo "==> Temporary sudo drop-in deleted ($dropin)"
}

# The user types the sudo password once; from here until the run ends sudo
# is password-free. EXIT covers success and failure (set -e); each signal
# exits with its conventional code, which runs the EXIT trap.
begin_attended_sudo() {
    say 'sudo: type your password for this VM (asked once; the run then uses a temporary drop-in)'
    sudo -v || die 'sudo -v failed — no drop-in installed'
    trap end_attended EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    install_sudo_dropin
}

end_attended() {
    [[ -z $loopback_dir ]] || rm -rf "$loopback_dir"
    remove_sudo_dropin
}

# yadm decrypt runs `gpg -d`, and gpg asks gpg-agent's pinentry for the
# passphrase. With no DISPLAY the guest's default is pinentry-curses, which
# draws one * per typed character: on 2026-11-03 the harness's script(1)
# recording kept the passphrase's length. So this decrypt alone runs gpg with
# --pinentry-mode loopback, through a wrapper first on yadm's PATH: gpg reads
# the passphrase itself, with terminal echo off, and prints nothing per
# character. The passphrase never passes through this script, no gpg or
# gpg-agent config is written, and end_attended deletes the wrapper. If
# loopback cannot be used, the run stops before asking: there is no fallback
# to a pinentry that may echo. Same skip test as bootstrap's own decrypt step
# (~/.zshenv), which then reports it as already decrypted.
loopback_dir=''
attended_decrypt() {
    local archive=$HOME/.local/share/yadm/archive attempt gpg
    if [[ ! -f $archive ]]; then
        say "Secrets: no encrypted archive at $archive — nothing to decrypt"
        return 0
    fi
    if [[ -f $HOME/.zshenv ]]; then
        say 'Secrets: already decrypted (~/.zshenv exists) — skipping yadm decrypt'
        return 0
    fi
    gpg=$(command -v gpg) || die 'gpg is not installed — cannot decrypt the archive'
    [[ -z $(yadm config yadm.gpg-program) ]] \
        || die 'yadm.gpg-program is set, so yadm would bypass the hidden-input gpg wrapper — unset it (yadm config --unset yadm.gpg-program) and run again; nothing was asked'
    if gpgconf --list-options gpg-agent 2>/dev/null \
        | awk -F: '$1 == "no-allow-loopback-pinentry" && $10 != "" { found = 1 } END { exit !found }'; then
        die 'gpg-agent.conf sets no-allow-loopback-pinentry, and the hidden-input passphrase prompt needs loopback — remove that line and run again; nothing was asked'
    fi
    loopback_dir=$(mktemp -d)
    printf '#!/bin/sh\nexec %q --pinentry-mode loopback "$@"\n' "$gpg" >"$loopback_dir/gpg"
    chmod +x "$loopback_dir/gpg"
    for attempt in 1 2 3; do
        say "Secrets: type the archive passphrase (attempt $attempt of 3, input hidden)"
        if PATH=$loopback_dir:$PATH yadm decrypt; then return 0; fi
    done
    die 'yadm decrypt failed 3 times — stopping before the long run'
}

# --unattended skips only the steps that need a person; name each with its
# command. Quarantine holds print their own remedies above ("HELD this run").
print_attended_followups() {
    say 'Done. Follow-ups --unattended skipped (run them in a terminal on the VM):'
    echo '  - OpenViking memory: the OpenBao passkey sign-in, when no key is stored yet:'
    echo '      ~/.local/bin/setup/openviking-memory'
    echo '  - Packages the quarantine held this run (bootstrap lists them above, if any)'
    echo '    install on a later run once they age in:'
    echo '      ~/.local/bin/setup/bootstrap --unattended'
}

expected_profile() {
    case $1 in
        daily-vm) printf '%s\t%s\n' guest-vmware inbox-daily-vm ;;
        work-vm) printf '%s\t%s\n' guest-vmware inbox-work-vm ;;
        qemu-harness) printf '%s\t%s\n' guest-qemu inbox-qemu-harness ;;
        *) die "unsupported machine class '$1'" ;;
    esac
}

assert_class_profile() {
    local expected=$1 actual profile adapter inbox files file name
    local active_adapter='' active_inbox='' adapter_count=0 inbox_count=0
    actual=$(yadm config local.class 2>/dev/null || true)
    [[ $actual == "$expected" ]] \
        || die "expected yadm class '$expected', found '${actual:-unset}'"
    # A command substitution, not `< <(...)`: expected_profile's die must
    # end the run with its own rc 2, not as a silent EOF for read.
    profile=$(expected_profile "$expected")
    IFS=$'\t' read -r adapter inbox <<<"$profile"
    files=$("$tools_dir/metapac-declared" --group-files) \
        || die 'could not resolve active metapac groups'
    while IFS= read -r file; do
        name=${file##*/}
        name=${name%.toml}
        case $name in
            # A group named for an architecture (guest-vmware-x86_64,
            # arch-aarch64) adds to the class's adapter; it is not a second one.
            *-x86_64 | *-aarch64) ;;
            hardware-* | guest-*)
                active_adapter=$name
                adapter_count=$((adapter_count + 1))
                ;;
            inbox-*)
                active_inbox=$name
                inbox_count=$((inbox_count + 1))
                ;;
        esac
    done <<<"$files"
    ((adapter_count == 1)) && [[ $active_adapter == "$adapter" ]] \
        || die "class '$expected' expected adapter '$adapter'; active: ${active_adapter:-none} (count $adapter_count)"
    ((inbox_count == 1)) && [[ $active_inbox == "$inbox" ]] \
        || die "class '$expected' expected inbox '$inbox'; active: ${active_inbox:-none} (count $inbox_count)"
    echo "--- class profile: $expected ($adapter, $inbox)"
}

cmd_bootstrap() {
    local class='' repo='' branch='' attended=0 current_branch ml
    while (($#)); do
        case $1 in
            --class)
                need "$@"
                class=$2
                shift 2
                ;;
            --repo)
                need "$@"
                repo=$2
                shift 2
                ;;
            --branch)
                need "$@"
                branch=$2
                shift 2
                ;;
            --attended)
                attended=1
                shift
                ;;
            *) die "bootstrap: unknown argument '$1'" ;;
        esac
    done
    [[ -n "$class" && -n "$repo" ]] \
        || die 'bootstrap needs --class and --repo'
    if ((attended)); then begin_attended_sudo; fi
    sudo pacman -S --needed --noconfirm git base-devel yadm
    # Clone, or refresh an existing checkout. A resumed guest cannot rely on
    # `yadm clone || true`: that silently keeps converging the first branch.
    # A live miss proved it: on 2026-08-13 a resumed run built a package
    # main had already removed. --ff-only makes surprise divergence fail
    # loudly instead of merging something nobody asked for.
    #
    # A resumed guest must also honour a CHANGED --branch: the harness
    # advertises VM_HARNESS_BRANCH as the way to validate guest-side bootstrap
    # changes pre-merge, and a refresh arm that only fast-forwarded whatever
    # was cloned first would keep testing the old branch — the same stale
    # checkout bug one level up. Fetch, switch if asked, then fast-forward.
    #
    # The same goes for a CHANGED --repo: a guest first cloned from GitHub
    # and later handed a VM_HARNESS_BUNDLE path must fetch from the bundle,
    # or the unpushed branch it carries is never seen.
    if yadm rev-parse --git-dir >/dev/null 2>&1; then
        echo "==> Refreshing the existing yadm checkout"
        if [[ $(yadm remote get-url origin 2>/dev/null || true) != "$repo" ]]; then
            echo "==> Pointing origin at '$repo'"
            yadm remote set-url origin "$repo"
        fi
        yadm fetch --prune origin
        current_branch=$(yadm rev-parse --abbrev-ref HEAD)
        if [[ -n "$branch" && "$current_branch" != "$branch" ]]; then
            echo "==> Switching the checkout to '$branch'"
            yadm checkout "$branch"
            current_branch=$branch
        fi
        [[ -n "$current_branch" && "$current_branch" != HEAD ]] \
            || die 'existing yadm checkout has no branch to fast-forward'
        yadm merge --ff-only "origin/$current_branch"
    else
        yadm clone --no-bootstrap ${branch:+-b "$branch"} "$repo"
    fi
    ml="$HOME/.local/share/metapac/machine-local.toml"
    yadm config local.class "$class"
    yadm alt
    mkdir -p "${ml%/*}"
    if [[ ! -e $ml ]]; then
        write_empty_machine_local >"$ml"
    elif grep -q '^# harness-owned guest hardware set' "$ml"; then
        migrate_legacy_machine_local "$ml"
    fi
    if ((attended)); then attended_decrypt; fi
    "$HOME/.local/bin/setup/bootstrap" --check --unattended
    "$HOME/.local/bin/setup/bootstrap" --unattended
    if ((attended)); then print_attended_followups; fi
}

cmd_check() {
    local class='' out rc=0 names='' vendored='' real=''
    while (($#)); do
        case $1 in
            --class)
                need "$@"
                class=$2
                shift 2
                ;;
            *) die "check: unknown argument '$1'" ;;
        esac
    done
    [[ -n $class ]] || die 'check needs --class'
    if dropin_present; then
        die "the temporary sudo drop-in $dropin is still there — a first bootstrap ended without deleting it. Delete it: sudo rm $dropin"
    fi
    assert_class_profile "$class"
    echo '--- unmanaged packages (vendored custom PKGBUILDs are expected):'
    # metapac's own failure must not look like the gate finding drift: with
    # `2>/dev/null` and set -e this died silently, and the host only saw
    # "guest command failed (rc=127)". Keep stderr, report the rc.
    out=$(metapac unmanaged) || rc=$?
    ((rc == 0)) || die "metapac unmanaged failed (rc=$rc) — the gate did not run"
    if [[ -n "$out" ]]; then
        names=$(printf '%s\n' "$out" | "$tools_dir/metapac-unmanaged-names") \
            || die 'could not parse metapac unmanaged output'
    fi
    vendored=$("$tools_dir/custom-pkgs" list) \
        || die 'could not list vendored packages'
    real=$(comm -23 \
        <(printf '%s\n' "$names" | sed '/^$/d' | sort -u) \
        <(printf '%s\n' "$vendored" | sed '/^$/d' | sort -u))
    if [[ -z "$real" ]]; then
        echo OK
    else
        printf '%s\n' "$real"
        exit 1
    fi
    echo '--- network service ownership:'
    systemctl is-enabled --quiet NetworkManager 2>/dev/null \
        || die 'NetworkManager is not enabled'
    systemctl is-active --quiet NetworkManager 2>/dev/null \
        || die 'NetworkManager is not active'
    if systemctl is-enabled --quiet systemd-networkd 2>/dev/null \
        || systemctl is-active --quiet systemd-networkd 2>/dev/null; then
        die 'systemd-networkd must be disabled and inactive when NetworkManager owns networking'
    fi
    echo 'NetworkManager enabled and active; systemd-networkd disabled and inactive'
    echo '--- enabled services (sample):'
    systemctl is-enabled sshd 2>/dev/null || true
    echo '--- graphical target reachable:'
    systemctl status graphical.target --no-pager | head -3 || true
    echo '--- drift report:'
    "$tools_dir/metapac-drift-report"
}

case "${1:-}" in
    bootstrap)
        shift
        cmd_bootstrap "$@"
        ;;
    check)
        shift
        cmd_check "$@"
        ;;
    '' | help)
        usage
        [[ "${1:-}" == help ]] || exit 2
        ;;
    *) die "unknown subcommand '$1'" ;;
esac
