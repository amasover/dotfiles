#!/usr/bin/env python3
"""Install the attended metal recipe from an Arch ISO root console.

This destroys the explicitly named disk only after the generated driver's live
preflight and exact WIPE confirmation. Passwords are always prompted by that driver.
"""

import argparse
import os
import re
import subprocess
import tempfile
from pathlib import Path


def hardware_facts(device):
    disk_bytes = int(
        subprocess.check_output(
            ["/usr/bin/blockdev", "--getsize64", device],
            text=True,
        )
    )
    match = re.search(
        r"^MemTotal:\s+(\d+)\s+kB$", Path("/proc/meminfo").read_text(), re.MULTILINE
    )
    if disk_bytes <= 0 or match is None or int(match.group(1)) <= 0:
        raise ValueError("cannot derive positive disk size and physical RAM")
    return disk_bytes // 1073741824, (int(match.group(1)) + 1048575) // 1048576


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "device", help="whole-disk canonical /dev path; inspect lsblk first"
    )
    parser.add_argument("--hostname", required=True)
    parser.add_argument("--user", default="aaron")
    args = parser.parse_args(argv)
    try:
        disk_gib, ram_gib = hardware_facts(args.device)
        print(f"device={args.device} disk={disk_gib}GiB ram={ram_gib}GiB", flush=True)
        out = Path(tempfile.mkdtemp(prefix="metal-provision-", dir="/run"))
        generator = Path(__file__).resolve().with_name("provision-seed")
        subprocess.run(
            [
                str(generator),
                "create",
                "--files-only",
                "--target",
                "metal",
                "--out",
                str(out),
                "--disk-device",
                args.device,
                "--disk-size",
                str(disk_gib),
                "--ram-gib",
                str(ram_gib),
                "--hostname",
                args.hostname,
                "--user",
                args.user,
            ],
            check=True,
        )
        driver = str(out / "run-install.sh")
        os.execv(driver, [driver])
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        parser.exit(1, f"install-on-metal: {exc}\n")


if __name__ == "__main__":
    main()
