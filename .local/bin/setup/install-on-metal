#!/usr/bin/env python3
"""Install the attended metal recipe onto one blank disk with pacstrap.

This destroys the explicitly named disk, and only after a live preflight and an
exact ``WIPE <device>`` confirmation typed on the console. There is no bypass
flag and no environment override: a confirmation bypass that exists is one that
eventually reaches real hardware.

Passwords are prompted here and never written to disk. The LUKS passphrase is
piped to cryptsetup and the user's password to chpasswd inside the target root,
so no credentials file exists to leak or to clean up. Root gets no password.

The layout is a 1 GiB ESP mounted at /boot plus LVM-on-LUKS carrying a root
volume and a dedicated resume volume sized to physical RAM. The volume group is
named for the target host, so two disks built by this recipe can coexist in one
machine without an ambiguous activation by name.

``--portable`` builds removable media that boots any UEFI x86_64 machine
instead (Story 2.57): rEFInd at the firmware's removable-media path with no
firmware boot entry, an initramfs without ``autodetect``, and a resume volume
sized to a fixed ceiling rather than the installing machine's RAM.

Subcommand ``metal-finalize`` is the first-boot handoff the install performs,
exposed for re-running it after a partial failure. ``metal-preflight`` is the
same target survey plus one check the install path cannot make: that the disk
and RAM match figures an operator supplies, rather than the ones read from the
machine this is running on.
"""

import argparse
import contextlib
import getpass
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, replace
from pathlib import Path

REFIND_MANAGED = "# Managed by dotfiles refind-config (Story 2.52, #230)."
THEME_MARKER = ".dotfiles-refind-managed"
GIB_BYTES = 1073741824
# A portable install's resume volume, reserved once for every machine the drive
# will meet. A machine with more memory boots it but cannot hibernate it.
RESUME_CEILING_GIB = 64
MIN_POST_SWAP_ROOT_GIB = 40
LVM_METADATA_HEADROOM_GIB = 1
ESP_MIB = 1023
DATA_START_MIB = 1024
LUKS_MAPPER = "cryptlvm"
# The name the target is unlocked under while installing. Distinct from
# LUKS_MAPPER, which a booted host built by this recipe already uses for its own
# root; the target's command line names its own mapping regardless.
INSTALL_MAPPER = "metal-install"
# Half-second tries while the target's keyring daemons exit after gpgconf.
UNMOUNT_ATTEMPTS = 20
# Official repositories only, whatever the installing machine's pacman.conf
# adds: the target keyring starts empty (-K), so a third-party repository's
# signatures could not verify anyway, and the host's file stays the host's.
# HookDir is never root-relative, so without it this machine's own
# /etc/pacman.d/hooks run inside the target: this workstation's quarantine
# gate aborted pacstrap there, its Exec missing from the new root.
PACSTRAP_CONF = """\
[options]
Architecture = auto
SigLevel = Required DatabaseOptional
LocalFileSigLevel = Optional
ParallelDownloads = 5
HookDir = {hookdir}

[core]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist
"""
ROOT_LV = "root"
RESUME_LV = "resume"
LOCALE = "en_US.UTF-8 UTF-8"

# The boot chain is tracked policy (Story 2.59), not a constant here: bootstrap
# links the same file into /etc on every machine, so a fresh target and a
# reconciled one cannot disagree about which initramfs they build.
MKINITCPIO_POLICY = Path(__file__).resolve().parents[3] / ".config/dotfiles/mkinitcpio"
HOOKS_POLICY = MKINITCPIO_POLICY / "hooks.conf"
HOOKS_DROPIN = "etc/mkinitcpio.conf.d/10-dotfiles-hooks.conf"
# Portable installs only, sourced after HOOKS_DROPIN to drop autodetect.
PORTABLE_POLICY = MKINITCPIO_POLICY / "portable.conf"
PORTABLE_DROPIN = "etc/mkinitcpio.conf.d/90-dotfiles-portable.conf"
# rEFInd's own directory on a fixed install; the removable-media fallback path
# on a portable one, so it boots with no firmware entry. refind-install names
# the binary bootx64.efi there and copies refind.conf beside it.
FIXED_REFIND_DIR = "EFI/refind"
PORTABLE_REFIND_DIR = "EFI/BOOT"
# The systemd chain's own equivalents replace these, and a systemd initramfs
# runs no runtime hooks, so any of them would be silently inert.
UDEV_ONLY_HOOKS = ("udev", "encrypt", "keymap", "consolefont", "resume")
REQUIRED_HOOKS = ("base", "systemd", "sd-encrypt", "lvm2", "filesystems")

PACKAGES = (
    "base",
    "linux",
    "linux-firmware",
    "mkinitcpio",
    "lvm2",
    "cryptsetup",
    # fsck.vfat, for the ESP entry genfstab writes with a nonzero pass number
    "dosfstools",
    "refind",
    "efibootmgr",
    "networkmanager",
    "sudo",
    "openssh",
    "git",
    "base-devel",
    "yadm",
    "zsh",
)

# Every binary the destructive phase needs, checked before the disk is touched,
# with the package that provides it. Archinstall was a single dependency;
# pacstrap spreads the work over many, and discovering a missing one after the
# wipe would leave an unbootable target. A booted workstation lacks some that
# the Arch ISO always carries, so the refusal names what to install.
REQUIRED_TOOLS = {
    "pacstrap": "arch-install-scripts",
    "genfstab": "arch-install-scripts",
    "arch-chroot": "arch-install-scripts",
    "sgdisk": "gptfdisk",
    "partprobe": "parted",
    "wipefs": "util-linux",
    "cryptsetup": "cryptsetup",
    "pvcreate": "lvm2",
    "vgcreate": "lvm2",
    "vgchange": "lvm2",
    "vgs": "lvm2",
    "lvcreate": "lvm2",
    "mkfs.ext4": "e2fsprogs",
    "mkfs.fat": "dosfstools",
    "mkswap": "util-linux",
    "mount": "util-linux",
    "umount": "util-linux",
    "blkid": "util-linux",
    "lsblk": "util-linux",
    "blockdev": "util-linux",
    "udevadm": "systemd",
    "gpgconf": "gnupg",
}


class InstallError(Exception):
    """A refusal or failure that should reach the console as one clear line."""


@dataclass(frozen=True)
class MetalFacts:
    device: str
    disk_size_gib: int
    ram_gib: int

    def __post_init__(self) -> None:
        validate_device(self.device)
        if self.disk_size_gib <= 0:
            raise InstallError("metal disk size must be a positive whole GiB value")
        if self.ram_gib <= 0:
            raise InstallError("metal RAM size must be a positive whole GiB value")


def validate_device(device: str) -> None:
    if not re.fullmatch(r"/dev/[A-Za-z0-9._+:-]+", device):
        raise InstallError(
            "metal disk device must be one canonical whole-disk /dev path"
        )


def root_gib(disk_size_gib: int) -> int:
    """Usable disk after the 1 GiB ESP and 1 GiB GPT/tail reserve."""
    value = disk_size_gib - 2
    if value < 20:
        raise InstallError(f"disk too small ({disk_size_gib}G) — need >= 22G")
    return value


def metal_layout_gib(disk_size_gib: int, ram_gib: int) -> tuple[int, int, int]:
    """Return root LV, resume LV, and future routine-swap sizes.

    The resume LV equals rounded physical RAM. ``hibernate-storage`` later
    creates the 1.5x routine swapfile inside root and requires another 10 GiB
    free. Forty GiB after that swapfile keeps the full workstation reconcile
    and package caches from repeating the old 38 GiB ENOSPC failure.
    """
    if ram_gib <= 0:
        raise InstallError("metal RAM size must be a positive whole GiB value")
    available = root_gib(disk_size_gib)
    routine = (ram_gib * 3 + 1) // 2
    root = available - ram_gib
    required_inside_root = routine + MIN_POST_SWAP_ROOT_GIB + LVM_METADATA_HEADROOM_GIB
    minimum = 2 + ram_gib + required_inside_root
    if root < required_inside_root:
        raise InstallError(
            f"disk too small for {ram_gib} GiB RAM ({disk_size_gib}G) — "
            f"metal hibernation layout needs >= {minimum}G"
        )
    return root, ram_gib, routine


def volume_group_name(hostname: str) -> str:
    """Name the volume group for the host so two recipe-built disks can coexist.

    A constant name makes early boot activate an ambiguous root pool the moment
    a second disk built by this recipe is attached.
    """
    # Trailing hyphens are the gap between what LVM accepts and what DNS does;
    # this string becomes both the volume group name and the hostname.
    if not re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?", hostname):
        raise InstallError(
            "hostname must be lowercase alphanumeric with internal hyphens, "
            "starting and ending with a letter or digit, at most 63 characters"
        )
    return hostname


def validate_username(user: str) -> None:
    if not re.fullmatch(r"[a-z_][a-z0-9_-]*", user):
        raise InstallError("user must be a portable Linux account name")


def partition_prefix(device: str) -> str:
    """What a partition of this disk is named before its index.

    nvme and mmc disks already end in a digit, so their partitions carry a 'p'
    separator: sda -> sda1, but nvme0n1 -> nvme0n1p1.
    """
    return f"{device}p" if device[-1].isdigit() else device


def partition_path(device: str, index: int) -> str:
    return f"{partition_prefix(device)}{index}"


@dataclass(frozen=True)
class TargetState:
    """What the installing machine reports about the target, read once."""

    disk_bytes: int
    ram_gib: int
    is_whole_disk: bool
    is_uefi: bool
    mountpoints: tuple[str, ...]
    holders: tuple[str, ...]

    def facts(self, device: str) -> MetalFacts:
        """Floor the capacity to whole GiB; RAM is already rounded up."""
        return MetalFacts(device, self.disk_bytes // GIB_BYTES, self.ram_gib)


def refuse_unsafe_target(device: str, state: TargetState) -> None:
    """Fail closed before the attended install can touch the disk."""
    if not state.is_uefi:
        raise InstallError("target must boot in UEFI mode")
    if not state.is_whole_disk:
        raise InstallError(f"target is not a whole disk: {device}")
    if any(value.strip() for value in state.mountpoints):
        raise InstallError("target disk or one of its children is mounted")
    if any(value.strip() for value in state.holders):
        raise InstallError(
            "target disk is held by an active device-mapper or RAID stack"
        )


def refuse_unexpected_facts(
    expected: MetalFacts, state: TargetState, portable: bool = False
) -> None:
    """Refuse a target that is not the machine the operator described.

    Only ``metal-preflight`` can fail here. The install path derives its facts
    from this same reading, so it has no expectation to disagree with and asks
    for none: the disk it installs to is the disk the operator named and typed
    a ``WIPE`` confirmation for. A portable layout reserves its resume volume for
    the ceiling, so any machine at or below it fits rather than only one.
    """
    minimum_bytes = expected.disk_size_gib * GIB_BYTES
    maximum_bytes = (expected.disk_size_gib + 1) * GIB_BYTES
    if not minimum_bytes <= state.disk_bytes < maximum_bytes:
        raise InstallError(
            f"target size does not match configured {expected.disk_size_gib} GiB"
        )
    if portable:
        if state.ram_gib > expected.ram_gib:
            raise InstallError(
                f"target RAM rounds to {state.ram_gib} GiB, above the "
                f"{expected.ram_gib} GiB portable resume ceiling"
            )
    elif state.ram_gib != expected.ram_gib:
        raise InstallError(
            f"target RAM rounds to {state.ram_gib} GiB, "
            f"recipe expects {expected.ram_gib} GiB"
        )


def require_wipe_confirmation(device: str, answer: str) -> None:
    if answer != f"WIPE {device}":
        raise InstallError("confirmation did not match")


def missing_tools(lookup=shutil.which) -> list[str]:
    return [name for name in REQUIRED_TOOLS if lookup(name) is None]


def require_tools(lookup=shutil.which) -> None:
    missing = missing_tools(lookup)
    if missing:
        packages = sorted({REQUIRED_TOOLS[name] for name in missing})
        raise InstallError(
            "missing installer tooling: "
            + ", ".join(f"{name} ({REQUIRED_TOOLS[name]})" for name in missing)
            + " — install with: pacman -S --needed "
            + " ".join(packages)
        )


def command_output(command: list[str]) -> str:
    result = subprocess.run(command, text=True, capture_output=True, check=False)
    if result.returncode:
        raise InstallError(f"target inspection failed: {command[0]}")
    return result.stdout.strip()


def run(command: list[str], *, stdin: bytes | None = None, label: str) -> None:
    """Run one installer step, failing with the step name rather than a traceback."""
    result = subprocess.run(command, input=stdin, check=False)
    if result.returncode:
        raise InstallError(f"{label} failed (rc={result.returncode})")


def read_disk_bytes(device: str) -> int:
    """Target capacity, straight from the machine running this installer."""
    try:
        disk_bytes = int(command_output(["blockdev", "--getsize64", device]))
    except ValueError as exc:
        raise InstallError(f"target disk size is malformed: {device}") from exc
    if disk_bytes <= 0:
        raise InstallError(f"target disk size is malformed: {device}")
    return disk_bytes


def read_ram_gib() -> int:
    """Physical RAM rounded up to whole GiB. The resume volume is sized from it."""
    try:
        meminfo = Path("/proc/meminfo").read_text()
    except OSError as exc:
        raise InstallError("cannot derive physical RAM from /proc/meminfo") from exc
    match = re.search(r"^MemTotal:\s+(\d+)\s+kB$", meminfo, re.MULTILINE)
    if match is None or int(match.group(1)) <= 0:
        raise InstallError("cannot derive physical RAM from /proc/meminfo")
    return (int(match.group(1)) + 1048575) // 1048576


def inspect_target(device: str) -> TargetState:
    """Read every fact the refusals need, once, before anything is touched."""
    validate_device(device)
    try:
        is_block = stat.S_ISBLK(Path(device).stat().st_mode)
    except OSError as exc:
        raise InstallError(f"cannot inspect target device: {device}") from exc
    is_whole_disk = (
        is_block and command_output(["lsblk", "-dnro", "TYPE", device]) == "disk"
    )
    return TargetState(
        # A capacity is only meaningful for a real disk, and refuse_unsafe_target
        # rejects anything else before this value is read by a caller.
        disk_bytes=read_disk_bytes(device) if is_whole_disk else 0,
        ram_gib=read_ram_gib(),
        is_whole_disk=is_whole_disk,
        is_uefi=Path("/sys/firmware/efi").is_dir(),
        mountpoints=tuple(
            command_output(["lsblk", "-nrpo", "MOUNTPOINT", device]).splitlines()
        ),
        holders=tuple(
            sorted(
                child.name
                for child in Path("/sys/class/block").glob("*/holders/*")
                if _belongs_to(child, device)
            )
        ),
    )


def survey_target(device: str) -> TargetState:
    """Attended inspection whose every refusal lands before the disk is touched."""
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise InstallError("an attended console or ssh -t session is required")
    require_tools()
    state = inspect_target(device)
    refuse_unsafe_target(device, state)
    return state


def on_install_medium() -> bool:
    """True on the Arch ISO, or a medium built from it, which mounts itself here."""
    return Path("/run/archiso").is_dir()


# Shared by every LVM command here. Even a read such as vgs writes a metadata
# backup and archive under /etc/lvm for any VG it finds without a current
# one, which on a booted host is the host's own VG on the host's own disk.
NO_LVM_BACKUP = ("--config", "backup { backup = 0 archive = 0 }")


def host_volume_groups() -> set[str]:
    return set(
        command_output(["vgs", *NO_LVM_BACKUP, "--noheadings", "-o", "vg_name"]).split()
    )


def host_mappers() -> set[str]:
    mapper = Path("/dev/mapper")
    return {entry.name for entry in mapper.iterdir()} if mapper.is_dir() else set()


def refuse_host_collisions(
    volume_group: str,
    portable: bool,
    install_medium: bool,
    host_groups: set[str],
    host_maps: set[str],
) -> None:
    """Refuse what would touch the installing machine itself (Story 2.58).

    A fixed install writes a firmware boot entry, which from a booted system
    lands in that system's own firmware. A volume group already named for the
    target would make vgcreate fail after the wipe, and early boot ambiguous.
    An open INSTALL_MAPPER belongs to an earlier, interrupted run: opening the
    target would fail after the wipe, and cleanup would close a mapping this
    run never made.
    """
    if not install_medium and not portable:
        raise InstallError(
            "a fixed install from a booted system would add a firmware boot entry "
            "to this machine; boot the install medium, or pass --portable"
        )
    if volume_group in host_groups:
        raise InstallError(
            f"volume group {volume_group} already exists on this machine; "
            "choose another --hostname"
        )
    if INSTALL_MAPPER in host_maps:
        raise InstallError(
            f"/dev/mapper/{INSTALL_MAPPER} is already open from an earlier run; "
            f"unmount what it holds, then: cryptsetup close {INSTALL_MAPPER}"
        )


def target_lvm(command: str, *arguments: str) -> list[str]:
    """An LVM command that sees only the target's PV and keeps no metadata copy.

    --devices keeps the command off every other device, overriding any host
    devices file; NO_LVM_BACKUP keeps the target's metadata out of the host's
    /etc/lvm.
    """
    return [
        command,
        "--devices",
        f"/dev/mapper/{INSTALL_MAPPER}",
        *NO_LVM_BACKUP,
        *arguments,
    ]


def confirm_wipe(device: str) -> None:
    print("This fresh-laptop recipe destroys every partition on:")
    print(command_output(["lsblk", "-dno", "PATH,SIZE,MODEL,SERIAL", device]))
    confirmation = f"WIPE {device}"
    require_wipe_confirmation(device, input(f"Type {confirmation} to continue: "))


def metal_preflight(expected: MetalFacts, portable: bool = False) -> None:
    """Check a target against operator-supplied facts before committing to it."""
    state = survey_target(expected.device)
    refuse_unexpected_facts(expected, state, portable)
    # A layout that cannot fit is a refusal, so it belongs here rather than
    # partway through build_storage, with the disk already wiped.
    metal_layout_gib(expected.disk_size_gib, expected.ram_gib)
    confirm_wipe(expected.device)


def _belongs_to(holder_link: Path, device: str) -> bool:
    """True when a /sys holders entry hangs off the named whole disk or a child."""
    owner = holder_link.parent.parent.name
    base = Path(device).name
    if owner == base:
        return True
    # Share the naming rule with partition_path, so a sibling namespace such as
    # nvme0n11 is not mistaken for a partition of nvme0n1, and an unrelated disk
    # such as sdaa is not mistaken for a partition of sda.
    prefix = partition_prefix(base)
    return owner.startswith(prefix) and owner[len(prefix) :].isdigit()


def prompt_confirmed(label: str, prompt_fn=None) -> str:
    prompt_fn = prompt_fn or getpass.getpass
    first = prompt_fn(f"{label}: ")
    if not first:
        raise InstallError(f"{label} cannot be empty")
    second = prompt_fn(f"Confirm {label.lower()}: ")
    if first != second:
        raise InstallError(f"{label} confirmation does not match")
    return first


def prompt_metal_credentials(user: str, prompt_fn=None) -> tuple[str, str]:
    """Prompt on the target console. Secrets stay in memory; nothing is written."""
    validate_username(user)
    user_password = prompt_confirmed("User password", prompt_fn)
    luks_passphrase = prompt_confirmed("Disk encryption password", prompt_fn)
    return user_password, luks_passphrase


def enable_locale(text: str, locale: str = LOCALE) -> str:
    """Uncomment one locale.gen entry, refusing a silent no-op.

    Arch ships the entry as ``#  en_US.UTF-8 UTF-8`` — two spaces — so a pattern
    anchored on a bare ``#`` matches nothing, generates no locale, and leaves
    ``locale.conf`` pointing at one that does not exist.
    """
    entry = re.escape(locale)
    updated, count = re.subn(rf"(?m)^[ \t]*#[ \t]*({entry})[ \t]*$", r"\1", text)
    if count:
        return updated
    if re.search(rf"(?m)^[ \t]*{entry}[ \t]*$", text):
        return text
    raise InstallError(f"target locale.gen carries no entry for {locale}")


def policy_hooks(text: str) -> list[str]:
    """The policy's one literal HOOKS array, refused unless it is the systemd chain.

    The guard Story 2.56 pointed at systemd arrays now points at udev ones: the
    command line this recipe writes carries ``rd.luks.name=``, which only
    ``sd-encrypt`` reads, so a udev array would never prompt for the passphrase.
    """
    matches = re.findall(r"(?m)^HOOKS=\(([^\n()]*)\)[ \t]*$", text)
    if len(matches) != 1:
        raise InstallError("HOOKS policy requires one literal mkinitcpio HOOKS array")
    hooks = shlex.split(matches[0])
    if not all(re.fullmatch(r"[a-zA-Z0-9_-]+", hook) for hook in hooks):
        raise InstallError("HOOKS policy carries unexpected tokens")
    missing = [hook for hook in REQUIRED_HOOKS if hook not in hooks]
    if missing:
        raise InstallError(
            f"HOOKS policy lacks {', '.join(missing)}; rd.luks.name= unlocks "
            "only through sd-encrypt in a systemd initramfs"
        )
    inert = [hook for hook in UDEV_ONLY_HOOKS if hook in hooks]
    if inert:
        raise InstallError(
            f"HOOKS policy carries udev-only {', '.join(inert)}, inert in a "
            "systemd initramfs"
        )
    if hooks.index("base") > hooks.index("systemd"):
        raise InstallError("HOOKS policy must place base before systemd")
    return hooks


def policy_text(policy: Path) -> str:
    try:
        return policy.read_text()
    except OSError as exc:
        raise InstallError(f"cannot read initramfs policy: {policy}") from exc


def initramfs_dropins(portable: bool) -> dict[str, str]:
    """Each target drop-in path and its content, read from tracked policy.

    The portable drop-in only filters ``autodetect`` out of the array the
    shared policy sets, so the two cannot disagree about the chain itself.
    """
    hooks = policy_text(HOOKS_POLICY)
    policy_hooks(hooks)
    dropins = {HOOKS_DROPIN: hooks}
    if portable:
        dropins[PORTABLE_DROPIN] = policy_text(PORTABLE_POLICY)
    return dropins


def install_dropins(root: Path, dropins: dict[str, str]) -> None:
    """Write the policy as the target's drop-ins; bootstrap later links the shared one.

    Copies rather than links, because the target has no checkout of this
    repository until bootstrap clones one.
    """
    for relative, text in dropins.items():
        path = root / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        if not path.is_file() or path.read_text() != text:
            atomic_write_text(path, text, 0o644)


def refind_dir(esp: Path) -> str:
    """Where rEFInd lives on an ESP: its own directory, or the removable fallback.

    The fallback path alone does not identify rEFInd, since any loader may sit
    there; refind.conf beside it does, and is what refind-install itself looks
    for when upgrading a ``--usedefault`` installation.
    """
    if (esp / FIXED_REFIND_DIR / "refind_x64.efi").is_file():
        return FIXED_REFIND_DIR
    fallback = esp / PORTABLE_REFIND_DIR
    if (fallback / "bootx64.efi").is_file() and (fallback / "refind.conf").is_file():
        return PORTABLE_REFIND_DIR
    raise InstallError("metal handoff finds no rEFInd installation on the target ESP")


def refind_linux_conf(volume_group: str, luks_uuid: str) -> str:
    """Kernel options for the rEFInd stanza rEFInd generates from /boot.

    ``refind-install`` derives this file from the *running* system, which inside
    an installer is the live medium, so the recipe writes it instead.

    ``SYSTEMD_SULOGIN_FORCE=1`` keeps emergency mode usable: the root account is
    locked, so sulogin otherwise refuses the rescue shell outright. No manpage
    documents it; ``systemd-sulogin-shell`` reads it from the command line.

    Deliberately no ``resume=``. A fresh install has no hibernation image to
    restore, and the first boot's handoff owns that option: ``hibernate-storage``
    selects the dedicated resume volume, then ``refind-config`` derives it as a
    UUID and persists it. Naming the volume here would pin a device path and
    short-circuit that handoff, because ``refind-config`` only synthesises
    ``resume=UUID=`` when the live command line carries no ``resume=`` at all.
    """
    options = " ".join(
        (
            f"rd.luks.name={luks_uuid}={LUKS_MAPPER}",
            f"root=/dev/{volume_group}/{ROOT_LV}",
            "rw",
            "SYSTEMD_SULOGIN_FORCE=1",
        )
    )
    return f'"Boot with standard options"  "{options}"\n'


def atomic_write_text(path: Path, content: str, mode: int) -> None:
    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            newline="\n",
            dir=path.parent,
            prefix=f".{path.name}.",
            delete=False,
        ) as handle:
            temporary = Path(handle.name)
            os.chmod(temporary, mode)
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        temporary = None
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def finalize_metal(root: Path, volume_group: str) -> None:
    """Persist resume swap and authorize first-boot rEFInd reconciliation.

    A portable install is recognised by where refind-install put rEFInd, so a
    rerun after a partial failure cannot be told the wrong shape.
    """
    root = root.resolve()
    if root == Path("/"):
        raise InstallError("metal finalization requires an offline target root")
    if not root.is_dir():
        raise InstallError(f"target root does not exist: {root}")
    volume_group = volume_group_name(volume_group)

    fstab = root / "etc/fstab"
    layout = refind_dir(root / "boot")
    boot_refind = root / "boot" / layout
    dropins = initramfs_dropins(portable=layout == PORTABLE_REFIND_DIR)
    paths = [
        fstab,
        boot_refind / "refind.conf",
        root / "boot/refind_linux.conf",
    ]
    theme = boot_refind / "themes/nord"
    theme_marker = theme / THEME_MARKER
    for path in (*paths, *(root / relative for relative in dropins), theme_marker):
        current = path
        while current != root:
            if current.is_symlink():
                raise InstallError(f"metal handoff destination is a symlink: {current}")
            current = current.parent
    if theme.exists() and (
        not theme_marker.is_file() or theme_marker.read_text() != REFIND_MANAGED + "\n"
    ):
        raise InstallError("metal handoff refuses an unmanaged Nord theme")
    contents: dict[Path, str] = {}
    for path in paths:
        if not path.is_file():
            raise InstallError(f"metal handoff destination is missing: {path}")
        contents[path] = path.read_text()

    # genfstab records mounted filesystems only, so the dedicated resume volume
    # is never in it. Persist the recipe's stable LV name rather than activating
    # target swap in the installer host.
    resume_entry = f"/dev/{volume_group}/{RESUME_LV} none swap sw,pri=-1 0 0"
    swap_entries = [
        fields
        for line in contents[fstab].splitlines()
        if (fields := line.split())
        and not fields[0].startswith("#")
        and len(fields) >= 3
        and fields[2] == "swap"
    ]
    if swap_entries and swap_entries != [resume_entry.split()]:
        raise InstallError("metal handoff fstab has conflicting swap entries")
    if not swap_entries:
        contents[fstab] = contents[fstab].rstrip("\n") + "\n\n" + resume_entry + "\n"

    install_dropins(root, dropins)
    for path, content in contents.items():
        if path != fstab:
            if content.startswith(REFIND_MANAGED + "\n"):
                continue
            content = REFIND_MANAGED + "\n" + content
        if path.read_text() != content:
            mode = path.stat().st_mode & 0o777
            atomic_write_text(path, content, mode)

    # Always rebuild: a previous attempt may have written the drop-in but failed here.
    chroot(root, ["mkinitcpio", "-P"], label="metal handoff initramfs rebuild")

    # The package hook copies Nord onto the ESP before bootstrap reconciles it.
    # Reserve ownership while the fresh target has no theme; never adopt an
    # existing unmarked directory. The package's copy preserves this marker.
    theme.mkdir(parents=True, exist_ok=True)
    if not theme_marker.exists():
        atomic_write_text(theme_marker, REFIND_MANAGED + "\n", 0o644)


def partition_disk(facts: MetalFacts) -> tuple[str, str]:
    """Wipe the target and lay down the ESP and LVM partitions."""
    device = facts.device
    esp, data = partition_path(device, 1), partition_path(device, 2)
    run(["wipefs", "--all", device], label="wipefs")
    run(["sgdisk", "--zap-all", device], label="sgdisk --zap-all")
    run(
        [
            "sgdisk",
            f"--new=1:1MiB:+{ESP_MIB}MiB",
            "--typecode=1:ef00",
            "--change-name=1:ESP",
            f"--new=2:{DATA_START_MIB}MiB:+{root_gib(facts.disk_size_gib)}GiB",
            "--typecode=2:8e00",
            "--change-name=2:cryptlvm",
            device,
        ],
        label="sgdisk --new",
    )
    run(["partprobe", device], label="partprobe")
    run(["udevadm", "settle"], label="udevadm settle")
    return esp, data


def build_storage(
    facts: MetalFacts, volume_group: str, luks_passphrase: str
) -> tuple[str, str]:
    """Encrypt, carve, and format the target. Returns the ESP node and LUKS UUID."""
    esp, data = partition_disk(facts)
    secret = luks_passphrase.encode()
    # --key-file - makes cryptsetup consume stdin verbatim, so the passphrase is
    # sent without a trailing newline and matches what is typed at the boot
    # prompt, where cryptsetup reads one newline-terminated line.
    run(
        [
            "cryptsetup",
            "luksFormat",
            "--type",
            "luks2",
            "--batch-mode",
            "--key-file",
            "-",
            data,
        ],
        stdin=secret,
        label="cryptsetup luksFormat",
    )
    run(
        ["cryptsetup", "open", "--key-file", "-", data, INSTALL_MAPPER],
        stdin=secret,
        label="cryptsetup open",
    )
    mapper = f"/dev/mapper/{INSTALL_MAPPER}"
    # The resume volume must be exactly rounded RAM; root takes whatever is left.
    # Sizing both explicitly would overcommit the PV, because the LUKS2 header and
    # LVM metadata consume space the partition-level arithmetic cannot see.
    _, resume_size, _ = metal_layout_gib(facts.disk_size_gib, facts.ram_gib)
    run(target_lvm("pvcreate", mapper), label="pvcreate")
    run(target_lvm("vgcreate", volume_group, mapper), label="vgcreate")
    run(
        target_lvm(
            "lvcreate", "--size", f"{resume_size}G", "--name", RESUME_LV, volume_group
        ),
        label="lvcreate resume",
    )
    run(
        target_lvm(
            "lvcreate", "--extents", "100%FREE", "--name", ROOT_LV, volume_group
        ),
        label="lvcreate root",
    )
    run(["mkfs.ext4", "-F", f"/dev/{volume_group}/{ROOT_LV}"], label="mkfs.ext4")
    run(["mkswap", f"/dev/{volume_group}/{RESUME_LV}"], label="mkswap")
    run(["mkfs.fat", "-F32", esp], label="mkfs.fat")
    return esp, command_output(["blkid", "-s", "UUID", "-o", "value", data])


def mount_target(root: Path, esp: str, volume_group: str) -> None:
    root.mkdir(parents=True, exist_ok=True)
    run(["mount", f"/dev/{volume_group}/{ROOT_LV}", str(root)], label="mount root")
    (root / "boot").mkdir(parents=True, exist_ok=True)
    run(["mount", esp, str(root / "boot")], label="mount esp")


def release_target(root: Path, volume_group: str) -> None:
    """Detach the target: stop its keyring daemons, unmount, deactivate its
    volume group, close LUKS.

    Best effort by design — this runs on the failure path too, where some of
    these are already undone, and a second failure here would mask the first.
    still_attached() reports whatever this did not release.
    """
    # pacstrap -K initializes the target's keyring from this machine, not from
    # inside a chroot, so the gpg daemons it starts outlive pacstrap and keep
    # the target busy. gpgconf only asks them to exit, so the unmount retries
    # briefly while they let go.
    subprocess.run(
        ["gpgconf", "--homedir", str(root / "etc/pacman.d/gnupg"), "--kill", "all"],
        check=False,
        capture_output=True,
    )
    for _ in range(UNMOUNT_ATTEMPTS):
        if not root.is_mount():
            break
        unmount = ["umount", "--recursive", str(root)]
        if not subprocess.run(unmount, check=False, capture_output=True).returncode:
            break
        time.sleep(0.5)
    for command in (
        target_lvm("vgchange", "--activate", "n", volume_group),
        ["cryptsetup", "close", INSTALL_MAPPER],
    ):
        subprocess.run(command, check=False, capture_output=True)


def still_attached(root: Path) -> list[str]:
    held = [str(root)] if root.is_mount() else []
    mapper = Path(f"/dev/mapper/{INSTALL_MAPPER}")
    return held + [str(mapper)] if mapper.exists() else held


def holders(root: Path) -> str:
    """Who keeps the target busy, for the report when it stays attached."""
    with contextlib.suppress(OSError):
        found = subprocess.run(
            ["fuser", "-vm", str(root)], capture_output=True, text=True, check=False
        )
        return (found.stdout + found.stderr).strip()
    return ""


def chroot(root: Path, command: list[str], *, stdin: bytes | None = None, label: str):
    run(["arch-chroot", str(root), *command], stdin=stdin, label=label)


def configure_target(
    root: Path,
    *,
    hostname: str,
    user: str,
    user_password: str,
    volume_group: str,
    luks_uuid: str,
    esp: str,
    portable: bool,
) -> None:
    """Bring the pacstrapped tree to the same state Archinstall used to leave."""
    (root / "etc/hostname").write_text(hostname + "\n")
    (root / "etc/vconsole.conf").write_text("KEYMAP=us\n")
    (root / "etc/locale.conf").write_text("LANG=en_US.UTF-8\n")
    locale_gen = root / "etc/locale.gen"
    locale_gen.write_text(enable_locale(locale_gen.read_text()))
    chroot(root, ["locale-gen"], label="locale-gen")
    chroot(
        root,
        ["ln", "-sf", "/usr/share/zoneinfo/UTC", "/etc/localtime"],
        label="timezone",
    )
    # What hwclock --systohc would leave, without writing the installing
    # machine's own clock: the target keeps its hardware clock in UTC.
    (root / "etc/adjtime").write_text("0.0 0 0.0\n0\nUTC\n")

    sudoers = root / "etc/sudoers.d/10-wheel"
    sudoers.parent.mkdir(parents=True, exist_ok=True)
    atomic_write_text(sudoers, "%wheel ALL=(ALL:ALL) ALL\n", 0o440)
    chroot(
        root,
        ["useradd", "--create-home", "--groups", "wheel", "--shell", "/bin/bash", user],
        label="useradd",
    )
    # The password reaches chpasswd on a pipe, so it never appears in argv or
    # on disk. Root stays locked: the wheel user administers through sudo, and
    # SYSTEMD_SULOGIN_FORCE=1 keeps the rescue shell open to a locked root.
    chroot(
        root,
        ["chpasswd"],
        stdin=f"{user}:{user_password}\n".encode(),
        label="chpasswd",
    )
    chroot(root, ["passwd", "--lock", "root"], label="lock root")
    for unit in ("NetworkManager", "sshd", "systemd-timesyncd"):
        chroot(root, ["systemctl", "enable", unit], label=f"enable {unit}")

    # --yes answers refind-install's own Y/N prompts, which would otherwise block
    # on a console this recipe is not driving. It does not weaken the typed
    # WIPE confirmation, which is this tool's and is asked before anything here.
    # It also declines Secure Boot MOK enrolment, which Story 2.44 owns.
    if portable:
        # The removable-media path, so any firmware boots the drive unaided.
        # refind-install never writes NVRAM for EFI/BOOT (refind-install:1476),
        # and --usedefault mounts the ESP device itself, excluding --root.
        chroot(
            root, ["refind-install", "--yes", "--usedefault", esp], label="refind-install"
        )
    else:
        chroot(root, ["refind-install", "--yes"], label="refind-install")
    # refind-install derives refind_linux.conf from the *running* system, which
    # inside an installer is the live medium, and skips it entirely on some
    # paths. Write the target's own kernel options unconditionally.
    atomic_write_text(
        root / "boot/refind_linux.conf",
        refind_linux_conf(volume_group, luks_uuid),
        0o644,
    )


def install(
    *,
    device: str,
    hostname: str,
    user: str,
    portable: bool = False,
    target: Path | None = None,
) -> None:
    if os.geteuid() != 0:
        raise InstallError("install-on-metal must run as root")
    validate_username(user)
    volume_group = volume_group_name(hostname)
    state = survey_target(device)
    refuse_host_collisions(
        volume_group,
        portable,
        on_install_medium(),
        host_volume_groups(),
        host_mappers(),
    )
    facts = state.facts(device)
    if portable:
        # The resume volume serves every machine the drive meets, so it is
        # sized to the ceiling rather than to whichever machine installs it.
        facts = replace(facts, ram_gib=RESUME_CEILING_GIB)
    # A layout that cannot fit is a refusal, so it belongs before the typed
    # confirmation rather than partway through build_storage.
    metal_layout_gib(facts.disk_size_gib, facts.ram_gib)
    # A policy that would build an unbootable chain is refused before the wipe.
    dropins = initramfs_dropins(portable)
    print(
        f"device={device} disk={facts.disk_size_gib}GiB "
        f"resume={facts.ram_gib}GiB vg={volume_group}"
        + (" portable" if portable else "")
    )
    if portable and state.ram_gib > RESUME_CEILING_GIB:
        print(
            f"note: this machine's {state.ram_gib} GiB RAM is above the "
            f"{RESUME_CEILING_GIB} GiB ceiling; the drive boots here but cannot "
            "hibernate here"
        )
    confirm_wipe(device)
    user_password, luks_passphrase = prompt_metal_credentials(user)

    root = target or Path(tempfile.mkdtemp(prefix="metal-target-", dir="/run"))
    try:
        esp, luks_uuid = build_storage(facts, volume_group, luks_passphrase)
        mount_target(root, esp, volume_group)
        # Before pacstrap, so the package hook's first image is already the
        # recipe's chain rather than the packaged default rebuilt afterwards.
        install_dropins(root, dropins)
        # The target's own administrator hook directory: empty at this point.
        hookdir = root / "etc/pacman.d/hooks"
        hookdir.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(
            "w", dir="/run", prefix="metal-pacman-", suffix=".conf"
        ) as conf:
            conf.write(PACSTRAP_CONF.format(hookdir=f"{hookdir}/"))
            conf.flush()
            run(
                ["pacstrap", "-C", conf.name, "-K", str(root), *PACKAGES],
                label="pacstrap",
            )
        # -f keeps only what is mounted under the target: genfstab otherwise
        # copies every active swap in /proc/swaps, which on a booted host are
        # the host's own.
        fstab = subprocess.run(
            ["genfstab", "-U", "-f", str(root), str(root)],
            capture_output=True,
            text=True,
            check=False,
        )
        if fstab.returncode:
            raise InstallError(f"genfstab failed (rc={fstab.returncode})")
        (root / "etc/fstab").write_text(fstab.stdout)
        configure_target(
            root,
            hostname=hostname,
            user=user,
            user_password=user_password,  # gitleaks:allow -- 2026-09-15: kwarg name
            volume_group=volume_group,
            luks_uuid=luks_uuid,
            esp=esp,
            portable=portable,
        )
        finalize_metal(root, volume_group)
    finally:
        # Leave nothing of the target attached to the installing machine, so a
        # failure is reproducible from a clean state and a host-side run does not
        # keep an unlocked volume open. build_storage belongs inside this block:
        # it opens the LUKS mapper and activates the volume group, so a failure
        # anywhere after that is exactly when the detach is needed.
        release_target(root, volume_group)
        held = still_attached(root)
        if held:
            # Never silent: pulling a drive that is still mounted and unlocked
            # loses data, and the next run would refuse the open mapping.
            print(
                f"metal-provision: still attached here: {', '.join(held)}. "
                f"Holding it:\n{holders(root) or '(fuser found nothing)'}\n"
                f"Stop those, then: umount -R {root}; "
                f"vgchange -an {volume_group}; cryptsetup close {INSTALL_MAPPER}",
                file=sys.stderr,
                flush=True,
            )
        elif target is None:
            with contextlib.suppress(OSError):
                root.rmdir()
    if held:
        raise InstallError("installed, but the target is still attached (see above)")
    print("metal-provision: install complete; remove install media, then reboot")


def install_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="install-on-metal",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "subcommands:\n"
            "  metal-preflight --device DEV --disk-size GIB (--ram-gib GIB | --portable)\n"
            "  metal-finalize --root DIR --volume-group NAME"
        ),
    )
    parser.add_argument(
        "device", help="whole-disk canonical /dev path; inspect lsblk first"
    )
    parser.add_argument("--hostname", required=True)
    parser.add_argument("--user", default="aaron")
    parser.add_argument(
        "--portable",
        action="store_true",
        help="removable media bootable on any UEFI x86_64 machine",
    )
    return parser


def preflight_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="install-on-metal metal-preflight",
        description="validate target facts and exact wipe confirmation",
    )
    parser.add_argument("--device", required=True)
    parser.add_argument("--disk-size", required=True, type=int)
    ram = parser.add_mutually_exclusive_group(required=True)
    ram.add_argument("--ram-gib", type=int)
    ram.add_argument(
        "--portable",
        action="store_true",
        help=f"accept any RAM up to the {RESUME_CEILING_GIB} GiB resume ceiling",
    )
    return parser


def finalize_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="install-on-metal metal-finalize",
        description=(
            "persist resume swap and mark fresh rEFInd files for repository takeover"
        ),
    )
    parser.add_argument("--root", required=True)
    parser.add_argument("--volume-group", required=True)
    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    # A bare device path is the primary form, so subcommands are dispatched by
    # name. argparse subparsers are themselves a positional and would claim that
    # device argument, rejecting it as an invalid subcommand choice.
    command = argv[0] if argv else ""
    try:
        if command == "metal-preflight":
            args = preflight_parser().parse_args(argv[1:])
            ram_gib = RESUME_CEILING_GIB if args.portable else args.ram_gib
            metal_preflight(
                MetalFacts(args.device, args.disk_size, ram_gib), args.portable
            )
            return 0
        if command == "metal-finalize":
            args = finalize_parser().parse_args(argv[1:])
            finalize_metal(Path(args.root), args.volume_group)
            print("metal-provision: resume swap persisted; rEFInd handoff marked")
            return 0
        args = install_parser().parse_args(argv)
        install(
            device=args.device,
            hostname=args.hostname,
            user=args.user,
            portable=args.portable,
        )
        return 0
    except InstallError as exc:
        print(f"metal-provision: install failed: {exc}", file=sys.stderr, flush=True)
        return 1
    except OSError as exc:
        print(f"metal-provision: install failed: {exc}", file=sys.stderr, flush=True)
        return 1


if __name__ == "__main__":
    sys.exit(main())
