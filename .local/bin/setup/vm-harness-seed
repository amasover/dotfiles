#!/usr/bin/env python3
"""vm-harness-seed — cloud-init NoCloud seed generator for the vm-harness family.

Builds the seed that drives an unattended archinstall on the official Arch ISO:
user_configuration.json + user_credentials.json (archinstall RELEASE dialect —
see the schema-skew runbook note), run-install.sh (the guest-side install
driver), cloud-init user-data/meta-data, and the seed ISO (volid CIDATA).

Extracted from the bash vm-harness's write_seed() as the host-neutral seam
(Story 2.36, #119) so the libvirt harness, the VMware Workstation harness, and
eventually the Story 2.29 provisioning recipe consume one generator instead of
forking it. Differences from the bash original are per-hypervisor parameters,
not behavior: disk device path, guest-tools package, and optional sshd in the
live ISO (the VMware harness's exec channel — libvirt uses the qemu agent).

Pure logic lives in functions; only main() touches the filesystem. Tests:
tests/test_vm_harness_seed.py (pytest, no VMware/libvirt/network).
"""

import argparse
import base64
import hashlib
import json
import secrets
import sys
from pathlib import Path

HYPERVISORS = {
    # device: where the disk appears in the guest; tools: guest-tools package;
    # services: tools services to enable (qemu-guest-agent's unit is
    # udev-activated by its virtio port, so nothing to enable there).
    "qemu": {"device": "/dev/vda", "tools": "qemu-guest-agent", "services": []},
    # vmtoolsd ships disabled; without it nothing VMware-side runs in the
    # guest — resolution autofit, timesync, host commands (Story 5.4).
    "vmware": {"device": "/dev/nvme0n1", "tools": "open-vm-tools",
               "services": ["vmtoolsd.service"]},
}

ARCHINSTALL_VERSION = "2.8.6"  # the RELEASE dialect the ISO ships (runbook: schema skew)

# --- sha512-crypt ($6$) -----------------------------------------------------
# Python 3.13 removed the crypt module, and archinstall's creds schema wants
# enc_password (a crypt hash). This is the reference sha512-crypt algorithm
# (Ulrich Drepper's spec) at the default 5000 rounds; verified against the
# spec's published test vector in the test suite.

_B64 = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"


def _b64_from_24bit(b2: int, b1: int, b0: int, n: int) -> str:
    w = (b2 << 16) | (b1 << 8) | b0
    out = []
    for _ in range(n):
        out.append(_B64[w & 0x3F])
        w >>= 6
    return "".join(out)


def sha512_crypt(password: str, salt: str | None = None, rounds: int = 5000) -> str:
    if salt is None:
        salt = "".join(secrets.choice(_B64) for _ in range(16))
    if not 0 < len(salt) <= 16:
        raise ValueError("salt must be 1..16 characters")
    pw = password.encode()
    sl = salt.encode()

    b = hashlib.sha512(pw + sl + pw).digest()
    a_input = pw + sl
    a_input += b * (len(pw) // 64) + b[: len(pw) % 64]
    i = len(pw)
    while i > 0:
        a_input += b if i & 1 else pw
        i >>= 1
    a = hashlib.sha512(a_input).digest()

    dp = hashlib.sha512(pw * len(pw)).digest()
    p = dp * (len(pw) // 64) + dp[: len(pw) % 64]
    ds = hashlib.sha512(sl * (16 + a[0])).digest()
    s = ds * (len(sl) // 64) + ds[: len(sl) % 64]

    c = a
    for r in range(rounds):
        block = p if r & 1 else c
        block += s if r % 3 else b""
        block += p if r % 7 else b""
        block += c if r & 1 else p
        c = hashlib.sha512(block).digest()

    order = [
        (0, 21, 42), (22, 43, 1), (44, 2, 23), (3, 24, 45), (25, 46, 4),
        (47, 5, 26), (6, 27, 48), (28, 49, 7), (50, 8, 29), (9, 30, 51),
        (31, 52, 10), (53, 11, 32), (12, 33, 54), (34, 55, 13), (56, 14, 35),
        (15, 36, 57), (37, 58, 16), (59, 17, 38), (18, 39, 60), (40, 61, 19),
        (62, 20, 41),
    ]
    enc = "".join(_b64_from_24bit(c[x], c[y], c[z], 4) for x, y, z in order)
    enc += _b64_from_24bit(0, 0, c[63], 2)
    prefix = f"$6$rounds={rounds}$" if rounds != 5000 else "$6$"
    return f"{prefix}{salt}${enc}"


# --- archinstall config -----------------------------------------------------


def root_gib(disk_size_gib: int) -> int:
    """Root fills the disk (Story 2.27): ESP takes the first GiB, 1 GiB tail slack."""
    r = disk_size_gib - 2
    if r < 20:
        raise ValueError(f"disk too small ({disk_size_gib}G) — need >= 22G")
    return r


def build_user_configuration(
    *, hypervisor: str, disk_size_gib: int, hostname: str, user: str, pubkey: str
) -> dict:
    hv = HYPERVISORS[hypervisor]
    device = hv["device"]
    custom_commands = [
        "systemctl enable sshd",
        *[f"systemctl enable {s}" for s in hv["services"]],
        # Serial console on every boot: kernel messages land in the serial log,
        # and the getty gives a login even when ssh is down.
        "sed -i 's|^options |options console=tty0 console=ttyS0 |' /boot/loader/entries/*.conf",
        "systemctl enable serial-getty@ttyS0.service",
        f"chsh -s /usr/bin/zsh {user} || true",
        f"echo '{user} ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/90-harness",
    ]
    if pubkey:
        custom_commands.append(
            f"install -d -m 700 /home/{user}/.ssh && echo '{pubkey}' > /home/{user}/.ssh/authorized_keys"
            f" && chmod 600 /home/{user}/.ssh/authorized_keys && chown -R {user}: /home/{user}/.ssh"
        )
    return {
        "version": ARCHINSTALL_VERSION,
        "archinstall-language": "English",
        "bootloader_config": {"bootloader": "Systemd-boot", "uki": False, "removable": False},
        "hostname": hostname,
        "kernels": ["linux"],
        "locale_config": {"kb_layout": "us", "sys_enc": "UTF-8", "sys_lang": "en_US"},
        "network_config": {"type": "nm"},
        "ntp": True,
        "packages": ["git", "base-devel", "yadm", "openssh", "zsh", hv["tools"]],
        "swap": {"enabled": True},
        "timezone": "UTC",
        "disk_config": {
            "config_type": "default_layout",
            "device_modifications": [
                {
                    "device": device,
                    "wipe": True,
                    "partitions": [
                        {
                            "obj_id": "11111111-1111-1111-1111-111111111111",
                            "status": "create", "type": "primary", "dev_path": None,
                            "start": {"unit": "MiB", "value": 1,
                                      "sector_size": {"value": 512, "unit": "B"}},
                            "size": {"unit": "MiB", "value": 1023,
                                     "sector_size": {"value": 512, "unit": "B"}},
                            "fs_type": "fat32", "flags": ["boot", "esp"], "btrfs": [],
                            "mount_options": [], "mountpoint": "/boot",
                        },
                        {
                            "obj_id": "22222222-2222-2222-2222-222222222222",
                            "status": "create", "type": "primary", "dev_path": None,
                            "start": {"unit": "MiB", "value": 1024,
                                      "sector_size": {"value": 512, "unit": "B"}},
                            "size": {"unit": "GiB", "value": root_gib(disk_size_gib),
                                     "sector_size": {"value": 512, "unit": "B"}},
                            "fs_type": "ext4", "flags": [], "btrfs": [],
                            "mount_options": [], "mountpoint": "/",
                        },
                    ],
                }
            ],
        },
        "custom_commands": custom_commands,
    }


def build_user_credentials(*, user: str, pass_hash: str) -> dict:
    return {
        "root_enc_password": pass_hash,
        "users": [{"username": user, "enc_password": pass_hash, "sudo": True}],
    }


RUN_INSTALL_SH = """#!/bin/sh
exec > /dev/ttyS0 2>&1
echo HARNESS-RUNCMD-START
# --skip-ntp: archinstall's own time-sync wait — a VM guest's clock is the
# host's via the RTC, and timesyncd may never sync in the NAT guest anyway.
# The config's "ntp": true still enables NTP on the installed system.
archinstall --config /root/user_configuration.json \\
            --creds  /root/user_credentials.json --silent --skip-ntp
rc=$?
echo "HARNESS-ARCHINSTALL-EXIT:$rc"
[ "$rc" -ne 0 ] && tail -n 80 /var/log/archinstall/install.log
# Safe to power off from here: this script runs as its own transient unit,
# detached from cloud-init, which finished long ago.
systemctl poweroff
"""

META_DATA = "instance-id: bootstrap-harness\nlocal-hostname: archiso\n"


def _b64(data: bytes) -> str:
    return base64.b64encode(data).decode()


def build_user_data(
    *, user_configuration: dict, user_credentials: dict, live_ssh_pubkey: str | None
) -> str:
    """Cloud-init user-data. runcmd launches the install driver as its OWN
    transient unit (systemd-run) so cloud-init finishes in seconds and the
    driver can power off without racing cloud-init's teardown (see the bash
    harness's write_seed for the full history).

    live_ssh_pubkey additionally opens root ssh in the LIVE ISO — the VMware
    harness's exec/debug channel (no qemu agent there). The libvirt harness
    passes None and keeps using the agent.
    """
    files = [
        ("/root/user_configuration.json",
         _b64(json.dumps(user_configuration, indent=2).encode()), None),
        ("/root/user_credentials.json",
         _b64(json.dumps(user_credentials, indent=2).encode()), None),
        ("/root/run-install.sh", _b64(RUN_INSTALL_SH.encode()), "0755"),
    ]
    lines = ["#cloud-config", "write_files:"]
    for path, content, perm in files:
        lines += [f"  - path: {path}", "    encoding: b64", f"    content: {content}"]
        if perm:
            lines.append(f"    permissions: '{perm}'")
    if live_ssh_pubkey:
        lines += [
            "ssh_authorized_keys:",
            f"  - {live_ssh_pubkey}",
        ]
    lines += [
        "bootcmd:",
        "  - [sh, -c, 'echo HARNESS-CLOUDINIT-UP > /dev/ttyS0']",
        "runcmd:",
    ]
    if live_ssh_pubkey:
        lines.append("  - [systemctl, start, sshd]")
    lines.append(
        "  - [systemd-run, --collect, --unit=harness-install, sh, /root/run-install.sh]"
    )
    return "\n".join(lines) + "\n"


def write_seed_iso(out_iso: Path, user_data: str, meta_data: str) -> None:
    """NoCloud seed ISO: volid CIDATA, Joliet + Rock Ridge (matches the bash
    harness's xorrisofs invocation; cloud-init finds the volume by label)."""
    import pycdlib

    iso = pycdlib.PyCdlib()
    iso.new(interchange_level=3, joliet=3, rock_ridge="1.09", vol_ident="CIDATA")
    for name, content in (("user-data", user_data), ("meta-data", meta_data)):
        data = content.encode()
        iso.add_fp(
            __import__("io").BytesIO(data), len(data),
            iso_path=f"/{name.replace('-', '').upper()}.;1",
            rr_name=name, joliet_path=f"/{name}",
        )
    iso.write(str(out_iso))
    iso.close()


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="vm-harness-seed", description=__doc__)
    ap.add_argument("--out", required=True, help="output directory (created; existing files replaced)")
    ap.add_argument("--hypervisor", required=True, choices=sorted(HYPERVISORS))
    ap.add_argument("--disk-size", required=True, type=int, metavar="GIB")
    ap.add_argument("--hostname", default="archvm")
    ap.add_argument("--user", default="aaron")
    group = ap.add_mutually_exclusive_group(required=True)
    group.add_argument("--password", help="throwaway VM password (hashed with sha512-crypt)")
    group.add_argument("--pass-hash", help="pre-computed crypt hash (deterministic runs)")
    ap.add_argument("--pubkey", default="", help="host public key for the installed user's authorized_keys")
    ap.add_argument("--live-ssh", action="store_true",
                    help="also enable root ssh (with --pubkey) in the live ISO — the VMware exec channel")
    args = ap.parse_args(argv)

    if args.live_ssh and not args.pubkey:
        ap.error("--live-ssh requires --pubkey")

    pass_hash = args.pass_hash or sha512_crypt(args.password)
    cfg = build_user_configuration(
        hypervisor=args.hypervisor, disk_size_gib=args.disk_size,
        hostname=args.hostname, user=args.user, pubkey=args.pubkey,
    )
    creds = build_user_credentials(user=args.user, pass_hash=pass_hash)
    user_data = build_user_data(
        user_configuration=cfg, user_credentials=creds,
        live_ssh_pubkey=args.pubkey if args.live_ssh else None,
    )

    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    (out / "user-data").write_text(user_data, newline="\n")
    (out / "meta-data").write_text(META_DATA, newline="\n")
    write_seed_iso(out / "seed.iso", user_data, META_DATA)
    print(out / "seed.iso")
    return 0


if __name__ == "__main__":
    sys.exit(main())
