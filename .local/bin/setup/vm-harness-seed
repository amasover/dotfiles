#!/usr/bin/env python3
"""Build Archinstall recipes and NoCloud seeds for VM and metal targets.

``create`` writes the release-dialect Archinstall configuration, install driver,
cloud-init files, and CIDATA ISO. The QEMU and VMware harness targets remain
unattended and use throwaway credentials. The ``daily-vm`` target shares VMware
hardware defaults but emits a LUKS-encrypted root without harness-only sudo or
serial policy. The metal target is an attended whole-disk install for a different
laptop: its seed contains no passwords, never starts installation automatically,
and requires console confirmation before erasing the named disk.

Pure recipe logic stays here so both harnesses, the daily VM, and metal consume
one module.
Archinstall schema: release 4.4 / configuration version 2.8.6; see the schema
skew record in docs/runbook-vm-validation.md.
"""

import argparse
import base64
import getpass
import hashlib
import json
import os
import re
import secrets
import shlex
import stat
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path


@dataclass(frozen=True)
class TargetSpec:
    name: str
    device: str | None
    packages: tuple[str, ...]
    services: tuple[str, ...]
    bootloader: str
    swap_enabled: bool
    encrypted: bool
    attended: bool
    harness: bool


@dataclass(frozen=True)
class MetalFacts:
    device: str
    disk_size_gib: int
    ram_gib: int

    def __post_init__(self) -> None:
        if not re.fullmatch(r"/dev/[A-Za-z0-9._+:-]+", self.device):
            raise ValueError(
                "metal disk device must be one canonical whole-disk /dev path"
            )
        if self.disk_size_gib <= 0:
            raise ValueError("metal disk size must be a positive whole GiB value")
        if self.ram_gib <= 0:
            raise ValueError("metal RAM size must be a positive whole GiB value")


@dataclass(frozen=True)
class ProvisioningRequest:
    target: TargetSpec
    disk_size_gib: int
    hostname: str
    user: str
    pubkey: str
    metal: MetalFacts | None = None


