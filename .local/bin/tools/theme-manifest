#!/usr/bin/env bash
# theme-manifest — per-theme bar list, role gating, and gap for the polybar
# launcher (Story 3.21, #173).
#
# A theme directory may carry a `bars` file declaring what the launcher
# should start, instead of the historical hardcoded bar/main contract:
#
#   # themes/<name>/bars
#   bar main-top-left                 # always launched
#   bar left-top-middle MONITOR_LEFT  # only when that role env is non-empty
#   gap-top 55                        # i3 top gap this theme needs (default 0)
#
# A theme without a `bars` file gets the DEFAULT contract (what launch.sh
# hardcoded before this tool): main, main-bottom, then left/extra/split-one/
# split-two gated on their MONITOR_* roles. Malformed lines are fatal — a
# typo'd manifest must not silently launch the wrong bars.
#
# Usage:
#   theme-manifest bars DIR        every bar as "name<TAB>role-or--", one/line
#                                  (manifest if present, else the default)
#   theme-manifest launchable DIR  bar names to launch under the CURRENT env:
#                                  ungated bars always, gated ones when their
#                                  role variable is set and non-empty
#   theme-manifest gap-top DIR     the theme's gap-top (0 when absent)
#   theme-manifest has-manifest DIR  rc 0 + "manifest" if DIR/bars exists,
#                                  rc 1 + "default" otherwise
set -euo pipefail

die() { echo "theme-manifest: $*" >&2; exit 2; }

default_bars() {
    printf '%s\n' \
        $'main\t-' \
        $'main-bottom\t-' \
        $'left\tMONITOR_LEFT' \
        $'extra\tMONITOR_EXTRA' \
        $'split-one\tMONITOR_SPLIT_TOP' \
        $'split-two\tMONITOR_SPLIT_BOTTOM'
}

parse() { # $1 = manifest file, $2 = want (bars|gap)
    local file=$1 want=$2 lineno=0 line kw a b
    local gap=0
    while IFS= read -r line || [[ -n $line ]]; do
        lineno=$((lineno + 1))
        line="${line%%#*}"
        [[ -z ${line//[[:space:]]/} ]] && continue
        # shellcheck disable=SC2086  # word splitting is the parse
        set -- $line
        kw=$1 a=${2-} b=${3-}
        case "$kw" in
        bar)
            [[ -n $a ]] || die "$file:$lineno: 'bar' needs a name"
            [[ $# -le 3 ]] || die "$file:$lineno: too many fields"
            [[ $want == bars ]] && printf '%s\t%s\n' "$a" "${b:--}"
            ;;
        gap-top)
            [[ $a =~ ^[0-9]+$ ]] || die "$file:$lineno: gap-top needs a number"
            gap=$a
            ;;
        *)
            die "$file:$lineno: unknown directive '$kw'"
            ;;
        esac
    done <"$file"
    [[ $want == gap ]] && printf '%s\n' "$gap"
    # a manifest that declares no bars is a mistake, not an empty theme
    if ! grep -Eq '^[[:space:]]*bar[[:space:]]' "$file"; then
        die "$file: no bar lines"
    fi
    return 0
}

manifest_of() { printf '%s/bars\n' "${1%/}"; }

cmd_bars() {
    local m; m=$(manifest_of "$1")
    if [[ -f $m ]]; then parse "$m" bars; else default_bars; fi
}

cmd_launchable() {
    local name role
    while IFS=$'\t' read -r name role; do
        if [[ $role == - || -n ${!role:-} ]]; then
            printf '%s\n' "$name"
        fi
    done < <(cmd_bars "$1")
}

cmd_gap_top() {
    local m; m=$(manifest_of "$1")
    if [[ -f $m ]]; then parse "$m" gap; else echo 0; fi
}

cmd_has_manifest() {
    if [[ -f $(manifest_of "$1") ]]; then echo manifest; else echo default; return 1; fi
}

case "${1:-}" in
-h | --help) sed -n '2,/^set -euo/{/^set -euo/d; s/^# \{0,1\}//p;}' "$0"; exit 0 ;;
esac
dir="${2:?usage: theme-manifest bars|launchable|gap-top|has-manifest THEME_DIR}"
[[ -d $dir ]] || die "no such theme dir: $dir"
case "${1:-}" in
bars) cmd_bars "$dir" ;;
launchable) cmd_launchable "$dir" ;;
gap-top) cmd_gap_top "$dir" ;;
has-manifest) cmd_has_manifest "$dir" ;;
*) die "unknown subcommand: ${1:-<none>}   (try: theme-manifest -h)" ;;
esac
