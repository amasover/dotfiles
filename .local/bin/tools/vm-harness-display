#!/usr/bin/env python3
"""vm-harness-display — attended-terminal renderer for vm-harness phases (Story 2.21).

Sits in run_phase's attended pipeline (bash harness, Linux):

    phase-cmd 2>&1 | vm-harness-display --mode bar --phase boot \
        [--phases create:done,install:done,boot:current,check:pending] | scrub >> log

Reads the raw stream on stdin and forwards it byte-faithfully to stdout (the
scrub -> state-log leg). All rendering happens on the terminal device
(/dev/tty; CONOUT$ on Windows), three rows:

  row 1: spinner + phase breadcrumb (done / CURRENT / pending, from --phases;
         falls back to the bare --phase name) + elapsed, right-aligned
  row 2: bootstrap step strip — bootstrap's `==>` say-lines are ours and the
         whole step list is known up front, so every step renders as its own
         breadcrumb (done green / CURRENT bold / pending dim); on terminals
         too narrow for all names it degrades to a dot meter (●●●▶○○ n/m NAME).
         Blank outside the bootstrap phase.
  row 3: the latest parsed anchor (pacman transaction steps, AUR builds,
         HARNESS-* markers) — the fast-moving detail, on its own row

  bar mode:     raw stream mirrored to the tty (full firehose) above the two
                pinned rows; a DECSTBM scroll region protects them. rich (if
                present) styles the text — rich can't own a terminal shared
                with a raw pty stream, hence the manual region (#73).
  compact mode: nothing raw reaches the tty — just the two live rows. run_phase
                prints the failing log's tail on nonzero rc.

The pass-through must never break: any rendering failure disables rendering
and the pump keeps going; rendering failures never change the exit code (the
pipeline's failure signal is the phase command itself, via pipefail). The one
exception is the --log leg: a log that cannot be opened or written is lost
phase output, not cosmetics, so that exits 3 — the driver fails the phase
instead of stamping rc=0 over a truncated log.

Windows sibling contract (Story 2.36 slice 4). The VMware driver has no sed
and no shell pipeline, so this tool also carries the harness's ANSI scrub —
the Python port of the bash harness's `scrub` sed filter — and can own the
whole log leg:

    vm-harness-display --mode scrub                 # stdin -> scrubbed stdout
                                                    # (the tests/ seam)
    vm-harness-display --mode bar|compact|plain --phase P --log FILE

With --log, the scrubbed stream is appended to FILE (write-through, so `tail`
stays near-live) and stdout carries only the terminal leg: bar mirrors the
raw stream on the terminal device, compact shows nothing raw, and plain
writes raw to a tty stdout or the scrubbed copy to a redirected one (the
same arms run_phase implements in bash). Without --log nothing changes for
the Linux pipeline: stdout stays the byte-faithful pass-through.

On Windows the terminal device is CONOUT$ with VT processing enabled, and
resizes are detected by polling (no SIGWINCH); rendering degrades to
pass-through on any failure, exactly as on Linux.
"""

import argparse
import io
import os
import re
import signal
import struct
import sys
import threading
import time

if os.name != "nt":
    import fcntl
    import termios

SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

# The guest tty echoes terminal replies (cursor-position ...R / window-size
# ...t reports) as literal '^[[' bytes — printable noise on the mirrored
# firehose. scrub already drops them from the state logs; this pair cleans
# the tty mirror only (the stdout leg stays byte-faithful for the log).
CARET_REPLY = re.compile(rb"\^\[\[[0-9;]*[Rt]")
CARET_PARTIAL = re.compile(rb"\^(\[(\[[0-9;]{0,24})?)?$")

# ---- ANSI scrub: the Python port of the bash harness's `scrub` sed filter ----
# Same expressions in the same order (see the sed comment in vm-harness):
# CSI (colors, cursor moves, agetty's soft reset), OSC with either terminator,
# DCS, charset selectors + ESC=/ESC>, CR handling, superseded sub-100%
# progress frames, caret-notation terminal replies. Byte regexes: the stream
# is not guaranteed UTF-8.
#
# One deliberate divergence from sed (fuzz-verified the only one): input NOT
# ending in a newline gets one appended at close — sed preserves the missing
# final newline. Here the next log write is the driver's rc trailer, which
# must start on its own line, never glued to an unterminated last line.
SCRUB_STRIPS = [
    re.compile(rb"\x1b\[[0-9;?!<>=]*[a-zA-Z]"),
    re.compile(rb"\x1b\][^\x1b\x07]*(?:\x07|\x1b\\)"),
    re.compile(rb"\x1bP[^\x1b]*\x1b\\"),
    re.compile(rb"\x1b[()][0-9A-Za-z]"),
    re.compile(rb"\x1b[=>]"),
]
SCRUB_FRAME = re.compile(rb"[^\n]*\[[#-]*\] *[0-9]{1,2}%\n")


def scrub_space(space):
    """One sed cycle over one pattern space (an input line, no trailing \\n):
    strip escapes, turn CR redraws into lines, drop every superseded sub-100%
    progress frame (the trailing segment has no newline, so the final frame
    of a redraw burst survives), strip caret-notation replies."""
    for pat in SCRUB_STRIPS:
        space = pat.sub(b"", space)
    if space.endswith(b"\r"):
        space = space[:-1]
    space = space.replace(b"\r", b"\n")
    space = SCRUB_FRAME.sub(b"", space)
    return CARET_REPLY.sub(b"", space)


class Scrubber:
    """Streaming wrapper: buffer to input newlines (sed's cycle boundary),
    emit one scrubbed pattern space per line, flush the remainder at close."""

    def __init__(self, sink):
        self.sink = sink      # callable(bytes)
        self.buf = b""

    def feed(self, chunk):
        self.buf += chunk
        *lines, self.buf = self.buf.split(b"\n")
        for line in lines:
            self.sink(scrub_space(line) + b"\n")

    def close(self):
        if self.buf:
            self.sink(scrub_space(self.buf) + b"\n")
            self.buf = b""

# Fast-moving detail: (pattern, text builder) — first match per line wins.
ANCHORS = [
    (re.compile(r"==> Making package: (\S+)"), lambda m: f"building {m.group(1)}"),
    (re.compile(r"HARNESS-CLOUDINIT-UP"), lambda m: "live ISO up (cloud-init)"),
    (re.compile(r"HARNESS-ARCHINSTALL-EXIT:(\d+)"),
     lambda m: f"archinstall exited rc={m.group(1)}"),
    (re.compile(r":: Retrieving packages"), lambda m: "downloading packages"),
    (re.compile(r":: Processing package changes"), lambda m: "installing packages"),
    (re.compile(r":: Running pre-transaction hooks"), lambda m: "pre-transaction hooks"),
    (re.compile(r":: Running post-transaction hooks"), lambda m: "post-transaction hooks"),
    (re.compile(r"bootstrap: sync attempt (\d+) failed"),
     lambda m: f"sync attempt {m.group(1)} failed — retrying"),
    (re.compile(r"aur-quarantine: HOLD (\S+)"), lambda m: f"quarantine hold: {m.group(1)}"),
    (re.compile(r"==> (.{1,80})"), lambda m: m.group(1).rstrip()),
]

# Bootstrap's own `==>` say-lines (stable — we write them), one strip entry
# per step, in execution order. Prefix match; the LONGEST matching prefix
# wins ("oh-my-zsh custom theme" must beat "oh-my-zsh").
BOOTSTRAP_STEPS = [
    ("connect", ("Waiting for ssh", "Trust baseline", "Running repo bootstrap")),
    ("secrets", ("Secrets",)),
    ("profile", ("Profile guard",)),
    ("local-group", ("Machine-local group",)),
    ("mirrors", ("Pacman mirrors",)),
    ("sync", ("System sync",)),
    ("pins", ("Provider pins",)),
    ("yay", ("yay",)),
    ("quarantine", ("Quarantine prerequisites",)),
    ("metapac", ("metapac",)),
    ("multilib", ("multilib repo",)),
    ("chaotic", ("chaotic-aur repo",)),
    ("preflight", ("Quarantine pre-flight",)),
    ("cache-warm", ("AUR PKGBUILD cache warm",)),
    ("reconcile", ("Package reconcile",)),
    ("retag", ("Normalizing install reasons",)),
    ("removal-hook", ("Package-removal hook",)),
    ("vendored", ("Vendored packages",)),
    ("baseline", ("AUR quarantine baseline",)),
    ("omz", ("oh-my-zsh",)),
    ("theme", ("oh-my-zsh custom theme",)),
    ("spacemacs", ("Spacemacs checkout",)),
    ("emacs-copilot", ("Emacs Copilot language server",)),
    ("claude-plugins", ("Claude Code plugins",)),
    ("vim-plugins", ("Vim plugins",)),
    ("user-services", ("User services",)),
    ("firefox-vmware", ("Firefox VMware acceleration",)),
    ("login-shell", ("Login shell",)),
]


def step_for(say_text):
    """Map a `==>` say-line onto its step index — None when unmapped."""
    best, best_len = None, 0
    for i, (_, prefixes) in enumerate(BOOTSTRAP_STEPS):
        for p in prefixes:
            if say_text.startswith(p) and len(p) > best_len:
                best, best_len = i, len(p)
    return best


def parse_phases(spec):
    """'create:done,boot:current,check:pending' -> [(name, status), ...]"""
    out = []
    for part in spec.split(","):
        name, _, status = part.partition(":")
        if name:
            out.append((name, status or "pending"))
    return out


def make_render():
    """Return (row1, row2) renderers producing ANSI strings; rich when
    importable (styled), plain otherwise — never a hard dependency."""
    try:
        from rich.console import Console
        from rich.text import Text

        def to_ansi(text, cols):
            text.truncate(max(cols - 1, 8), overflow="ellipsis")
            console = Console(file=io.StringIO(), force_terminal=True, width=cols)
            console.print(text, end="")
            return console.file.getvalue()

        def row1(spin, phases, label, elapsed, cols):
            text = Text()
            text.append(f" {spin} ", style="bold cyan")
            if phases:
                first = True
                for name, status in phases:
                    if not first:
                        text.append(" · ", style="dim")
                    first = False
                    if status == "done":
                        text.append(f"{name} ✓", style="green")
                    elif status == "current":
                        text.append(name.upper(), style="bold cyan")
                    else:
                        text.append(name, style="dim")
            else:
                text.append(label, style="bold")
            pad = cols - text.cell_len - len(elapsed) - 2
            text.append(" " * max(pad, 1))
            text.append(elapsed, style="dim")
            return to_ansi(text, cols)

        def _step_name(text, i, step_idx):
            name = BOOTSTRAP_STEPS[i][0]
            if i < step_idx:
                text.append(name, style="green")
            elif i == step_idx:
                text.append(name.upper(), style="bold yellow")
            else:
                text.append(name, style="dim")

        def row2(step_idx, cols):
            # Responsive: full names when they fit; otherwise dot meter (global
            # position) + a window of names around the current step, shrinking
            # the window until it fits; last resort is meter + counter + name.
            if step_idx is None:
                return ""
            n = len(BOOTSTRAP_STEPS)
            text = Text()
            text.append("   ")
            for i in range(n):
                if i:
                    text.append(" · ", style="dim")
                _step_name(text, i, step_idx)
            if text.cell_len <= cols - 1:
                return to_ansi(text, cols)
            for win in (3, 2, 1, 0):
                text = Text()
                text.append("   ")
                text.append("●" * step_idx, style="green")
                text.append("▶", style="bold yellow")
                text.append("○" * (n - step_idx - 1), style="dim")
                text.append(f" {step_idx + 1}/{n}  ", style="dim")
                lo, hi = max(0, step_idx - win), min(n, step_idx + win + 1)
                if lo > 0:
                    text.append("… ", style="dim")
                for i in range(lo, hi):
                    if i > lo:
                        text.append(" · ", style="dim")
                    _step_name(text, i, step_idx)
                if hi < n:
                    text.append(" …", style="dim")
                if text.cell_len <= cols - 1 or win == 0:
                    return to_ansi(text, cols)

        def row3(detail, cols):
            if not detail:
                return ""
            text = Text()
            text.append("   ")
            text.append(detail, style="dim")
            return to_ansi(text, cols)

        return row1, row2, row3
    except Exception:
        def row1(spin, phases, label, elapsed, cols):
            if phases:
                crumbs = []
                for name, status in phases:
                    if status == "done":
                        crumbs.append(f"{name} ✓")
                    elif status == "current":
                        crumbs.append(name.upper())
                    else:
                        crumbs.append(name)
                left = f" {spin} " + " · ".join(crumbs)
            else:
                left = f" {spin} {label}"
            pad = max(cols - len(left) - len(elapsed) - 2, 1)
            return (left + " " * pad + elapsed)[: max(cols - 1, 8)]

        def row2(step_idx, cols):
            if step_idx is None:
                return ""
            n = len(BOOTSTRAP_STEPS)
            names = [name.upper() if i == step_idx else name
                     for i, (name, _) in enumerate(BOOTSTRAP_STEPS)]
            line = "   " + " · ".join(names)
            if len(line) <= cols - 1:
                return line
            meter = "●" * step_idx + "▶" + "○" * (n - step_idx - 1) + f" {step_idx + 1}/{n}  "
            for win in (3, 2, 1, 0):
                lo, hi = max(0, step_idx - win), min(n, step_idx + win + 1)
                window = " · ".join(names[lo:hi])
                line = ("   " + meter + ("… " if lo > 0 else "")
                        + window + (" …" if hi < n else ""))
                if len(line) <= cols - 1 or win == 0:
                    return line[: max(cols - 1, 8)]

        def row3(detail, cols):
            return ("   " + detail)[: max(cols - 1, 8)] if detail else ""

        return row1, row2, row3


class Renderer:
    """Owns /dev/tty: firehose mirroring (bar mode) + the two status rows.

    One lock covers every tty write so row redraws never interleave with a
    mirrored chunk's escape sequences. The SIGWINCH handler only sets a flag —
    taking the lock in a signal handler could deadlock against the main
    thread's own write — and the ticker applies the resize."""

    RESERVED = 3  # pinned rows at the bottom

    def __init__(self, tty, mode, label, phases):
        self.tty = tty
        self.mode = mode
        self.label = label
        self.phases = phases
        self.step_idx = None       # bootstrap step strip position — slow
        self.detail = ""           # parsed anchor — fast, own row
        self.t0 = time.monotonic()
        self.lock = threading.Lock()
        self.resized = False
        self.dead = False
        self.mirror_carry = b""
        self.compact_drawn = False
        self.spin_i = 0
        self.rows, self.cols = self._size()
        self.row1, self.row2, self.row3 = make_render()
        if self.mode == "bar":
            self._set_region()
        self.draw()
        self.ticker = threading.Thread(target=self._tick, daemon=True)
        self.ticker.start()

    def _size(self):
        try:
            if os.name == "nt":
                s = os.get_terminal_size(self.tty.fileno())
                return (s.lines or 24), (s.columns or 80)
            r, c = struct.unpack("HHHH", fcntl.ioctl(self.tty, termios.TIOCGWINSZ, b"\0" * 8))[:2]
            return (r or 24), (c or 80)
        except Exception:
            return 24, 80

    def _set_region(self):
        # Reserve the bottom rows: scroll region = rows 1..N-2, then park the
        # cursor inside the region so the next output can't land on the bar.
        top = self.rows - self.RESERVED
        self.tty.write(b"\x1b7" + f"\x1b[1;{top}r".encode() + b"\x1b8"
                       + f"\x1b[{top};1H".encode())
        self.tty.flush()

    def _reset_region(self):
        self.tty.write(b"\x1b[r")
        for r in range(self.rows - self.RESERVED + 1, self.rows + 1):
            self.tty.write(f"\x1b[{r};1H\x1b[2K".encode())
        self.tty.write(f"\x1b[{self.rows - self.RESERVED};1H".encode())
        self.tty.flush()

    def _apply_resize_locked(self):
        # Caller holds self.lock. Applied before ANY tty write, not just on
        # the ticker: between SIGWINCH and the next tick every mirrored chunk
        # would otherwise scroll with stale margins (some terminals also reset
        # DECSTBM on resize), dragging the pinned rows into the log.
        self.resized = False
        self.rows, self.cols = self._size()
        if self.mode == "bar":
            self._set_region()
            self._paint_rows_locked()

    def _paint_rows_locked(self):
        r1, r2, r3 = self._row_bytes()
        self.tty.write(b"\x1b7"
                       + f"\x1b[{self.rows - 2};1H\x1b[2K".encode() + r1
                       + f"\x1b[{self.rows - 1};1H\x1b[2K".encode() + r2
                       + f"\x1b[{self.rows};1H\x1b[2K".encode() + r3
                       + b"\x1b8")

    def mirror(self, chunk, final=False):
        if self.dead or self.mode != "bar":
            return
        try:
            data = CARET_REPLY.sub(b"", self.mirror_carry + chunk)
            self.mirror_carry = b""
            if not final:
                # hold back a trailing partial reply so it can't slip through
                # split across two chunks; flushed on the next call or at close
                m = CARET_PARTIAL.search(data)
                if m and m.start() < len(data):
                    self.mirror_carry = data[m.start():]
                    data = data[: m.start()]
            if not data:
                return
            with self.lock:
                if self.resized:
                    self._apply_resize_locked()
                self.tty.write(data)
                self.tty.flush()
        except Exception:
            self.dead = True

    def _row_bytes(self):
        elapsed = int(time.monotonic() - self.t0)
        h, rem = divmod(elapsed, 3600)
        m, s = divmod(rem, 60)
        stamp = f"{h}:{m:02}:{s:02}" if h else f"{m:02}:{s:02}"
        spin = SPINNER[self.spin_i % len(SPINNER)]
        return (self.row1(spin, self.phases, self.label, stamp, self.cols).encode(),
                self.row2(self.step_idx, self.cols).encode(),
                self.row3(self.detail, self.cols).encode())

    def draw(self):
        if self.dead:
            return
        try:
            with self.lock:
                if self.resized:
                    self._apply_resize_locked()
                if self.mode == "bar":
                    self._paint_rows_locked()
                else:
                    r1, r2, r3 = self._row_bytes()
                    # compact: a three-line in-place block (no firehose to share
                    # the terminal with) — move back up over the previous draw
                    if self.compact_drawn:
                        self.tty.write(b"\r\x1b[2A")
                    self.tty.write(b"\x1b[2K" + r1 + b"\n\x1b[2K" + r2 + b"\n\x1b[2K" + r3)
                    self.compact_drawn = True
                self.tty.flush()
        except Exception:
            self.dead = True

    def _tick(self):
        while not self.dead:
            time.sleep(0.5)
            # No SIGWINCH on Windows: poll for a size change instead. The
            # flag-then-apply path is the same one the signal handler uses.
            if os.name == "nt" and not self.resized \
                    and self._size() != (self.rows, self.cols):
                self.resized = True
            self.spin_i += 1
            self.draw()

    def on_line(self, line):
        say = re.search(r"==> (.{1,80})", line)
        if say:
            new_step = step_for(say.group(1).rstrip())
            if new_step is not None:
                # A step-mapped say-line starts a fresh step: clearing the
                # detail keeps the strip from echoing itself — detail
                # repopulates from the fast anchors (pacman, builds, markers).
                self.step_idx = new_step
                self.detail = ""
                self.draw()
                return
        for pattern, build in ANCHORS:
            m = pattern.search(line)
            if m:
                detail = build(m)
                if detail != self.detail:
                    self.detail = detail
                    self.draw()
                return

    def close(self):
        self.mirror(b"", final=True)   # flush any held-back partial reply
        # Always try to undo the scroll region — even after a render error
        # (dead=True): leaving DECSTBM set would wedge the caller's terminal.
        self.dead = True
        try:
            with self.lock:
                if self.mode == "bar":
                    self._reset_region()
                else:
                    self.tty.write(b"\r\x1b[2K")
                    if self.compact_drawn:
                        self.tty.write(b"\x1b[1A\x1b[2K\x1b[1A\x1b[2K")
                self.tty.flush()
        except Exception:
            pass


def open_tty():
    """The terminal device, VT-capable: /dev/tty, or CONOUT$ with virtual-
    terminal processing switched on (Windows Terminal has it on already;
    legacy conhost needs the SetConsoleMode). Raises when there is no console
    — the caller degrades to pass-through."""
    if os.name != "nt":
        return open("/dev/tty", "r+b", buffering=0)
    import atexit
    import ctypes
    import msvcrt
    f = open("CONOUT$", "r+b", buffering=0)
    handle = msvcrt.get_osfhandle(f.fileno())
    k32 = ctypes.windll.kernel32
    # explicit argtypes: ctypes' default int conversion truncates a 64-bit
    # HANDLE; console handles are small today, but that's luck, not contract
    k32.GetConsoleMode.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_uint32)]
    k32.GetConsoleMode.restype = ctypes.c_int
    k32.SetConsoleMode.argtypes = [ctypes.c_void_p, ctypes.c_uint32]
    k32.SetConsoleMode.restype = ctypes.c_int
    mode = ctypes.c_uint32()
    if not k32.GetConsoleMode(handle, ctypes.byref(mode)):
        f.close()
        raise OSError("no console")
    ENABLE_VT = 0x0004
    if not mode.value & ENABLE_VT:
        if not k32.SetConsoleMode(handle, mode.value | ENABLE_VT):
            f.close()
            raise OSError("console refused VT mode")
        # legacy conhost: put the mode back on exit — the next legacy app in
        # this window shouldn't inherit VT processing we switched on
        atexit.register(k32.SetConsoleMode, handle, mode.value)
    return f


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--mode", choices=["bar", "compact", "plain", "scrub"],
                    required=True)
    ap.add_argument("--phase", default="")
    ap.add_argument("--phases", default="",
                    help="breadcrumb: name:status[,name:status...] (done|current|pending)")
    ap.add_argument("--log", default="",
                    help="append the scrubbed stream to this file; stdout then "
                         "carries only the terminal leg (see module docstring)")
    args = ap.parse_args()
    if args.mode in ("bar", "compact") and not args.phase:
        ap.error("--phase is required with --mode bar|compact")
    if args.mode == "scrub" and args.log:
        ap.error("--log is not valid with --mode scrub (scrub already writes the scrubbed stream to stdout)")

    phases = parse_phases(args.phases)
    out = sys.stdout.buffer

    def write_out(data):
        # Shared stdout leg with the pass-through's broken-pipe contract:
        # downstream gone means stop writing there, never a crash.
        nonlocal out
        if out is None:
            return
        try:
            out.write(data)
            out.flush()
        except BrokenPipeError:
            # Downstream (scrub/log leg) is gone; pipefail carries the real
            # rc. Point fd 1 at /dev/null so interpreter teardown doesn't
            # print a second BrokenPipeError to the terminal.
            os.dup2(os.open(os.devnull, os.O_WRONLY), 1)
            out = None

    if args.mode == "scrub":
        # Pure filter — the tests/ seam for the log scrub, and `vm-harness
        # scrub`'s sibling. No terminal, no log, exit 0.
        scrubber = Scrubber(write_out)
        while True:
            chunk = os.read(0, 65536)
            if not chunk:
                break
            scrubber.feed(chunk)
        scrubber.close()
        sys.exit(0)

    renderer = None
    if args.mode in ("bar", "compact"):
        try:
            tty = open_tty()
            renderer = Renderer(tty, args.mode, args.phase, phases)
            if hasattr(signal, "SIGWINCH"):
                signal.signal(signal.SIGWINCH,
                              lambda *_: setattr(renderer, "resized", True))
        except Exception:
            renderer = None  # no tty / setup failure: plain pass-through

    # The log leg (--log): scrubbed stream appended write-through, so a
    # concurrent `tail` stays near-live. stdout then carries the terminal leg:
    # bar-with-renderer mirrors on the tty (stdout silent); compact shows
    # nothing raw; everything else (plain, or a failed renderer) sends raw to
    # a tty stdout or the scrubbed copy to a redirected one — the same arms
    # the bash run_phase implements.
    log_f = None
    scrubber = None
    log_failed = []            # first --log OSError — the exit-3 signal
    if args.log:
        try:
            log_f = open(args.log, "ab", buffering=0)
        except OSError as e:
            # Rendering degrades; the log leg must not (module docstring): a
            # log this tool cannot write is lost phase output, and the driver
            # keys the phase's fate off this exit code.
            sys.stderr.write(f"vm-harness-display: FATAL: cannot open --log {args.log}: {e}\n")
            sys.exit(3)

        def log_write(data):
            # First failure reports once and disarms the leg; the pump keeps
            # serving the console, and EOF exits 3 so the driver fails the
            # phase instead of stamping a clean rc over a truncated log.
            if log_failed:
                return
            try:
                log_f.write(data)
            except OSError as e:
                log_failed.append(e)
                sys.stderr.write(f"vm-harness-display: FATAL: --log write failed: {e}\n")

        sinks = [log_write]
        raw_stdout = False
        if renderer is None and args.mode != "compact":
            if out.isatty():
                raw_stdout = True
            else:
                sinks.append(write_out)
        scrubber = Scrubber(lambda data: [s(data) for s in sinks])
    else:
        raw_stdout = True  # Linux contract: byte-faithful pass-through

    tail = b""
    try:
        while True:
            chunk = os.read(0, 65536)
            if not chunk:
                break
            if raw_stdout:
                write_out(chunk)
            if scrubber:
                scrubber.feed(chunk)
            if renderer:
                renderer.mirror(chunk)
                if renderer.dead and not raw_stdout and args.mode == "bar":
                    # tty rendering died mid-phase: reopen the stdout leg so
                    # the console isn't dark for the rest of the phase (the
                    # log keeps filling either way), starting with the chunk
                    # the dead mirror just dropped
                    raw_stdout = True
                    write_out(chunk)
                # Anchor scan: \r and \n both end a "line" (progress redraws).
                tail += chunk
                *lines, tail = re.split(rb"[\r\n]", tail)
                if len(tail) > 8192:  # runaway unterminated line — keep the end
                    tail = tail[-1024:]
                for raw in lines:
                    if raw:
                        renderer.on_line(raw.decode("utf-8", "replace"))
    finally:
        if scrubber:
            scrubber.close()
        if log_f:
            try:
                log_f.close()
            except OSError:
                pass
        if renderer:
            renderer.close()
    sys.exit(3 if log_failed else 0)


if __name__ == "__main__":
    main()
