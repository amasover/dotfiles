#!/bin/sh
# monitor-roles — assign polybar monitor roles positionally (Story 5.5, #152).
#
# Reads `xrandr --listactivemonitors` and emits eval-able assignments:
#   MONITOR_MAIN   the primary monitor ('*' flag), else the first listed
#   MONITOR_LEFT   the leftmost monitor positioned left of MAIN, if any
#   MONITOR_EXTRA  the next remaining monitor, if any
# Monitors beyond those roles get a stderr warning, never a silent drop
# (launch.sh surfaces the warnings as notifications).
# Split-4K roles (MONITOR_SPLIT_TOP/BOTTOM) can't be inferred — they come
# from per-autorandr-profile override files applied on top of the heuristic
# via merge-env (see polybar/launch.sh and polybar/layouts/).
#
# Output is eval'd by launch.sh, so emitted values are restricted to
# [A-Za-z0-9._~-]; a monitor whose name falls outside that set is dropped
# with a warning instead of handing eval shell metacharacters.
#
#   monitor-roles                query xrandr and assign
#   monitor-roles assign         read listactivemonitors text on stdin (test seam)
#   monitor-roles merge-env F    emit the MONITOR_* assignments from override
#                                file F, warning about anything else in it

usage() {
    echo "usage: monitor-roles [assign | merge-env FILE]" >&2
    exit 2
}

assign() {
    awk '
        /^[[:space:]]*[0-9]+:/ {
            name = $2
            gsub(/^[+*]+/, "", name)
            if (name !~ /^[A-Za-z0-9._~-]+$/) {
                print "monitor-roles: dropping monitor with unsafe name: " name > "/dev/stderr"
                next
            }
            n++
            names[n] = name
            split($3, g, "+")
            xs[n] = g[2] + 0
            prim[n] = ($2 ~ /^[+*]*\*/)
        }
        END {
            if (n == 0) {
                print "monitor-roles: no active monitors parsed" > "/dev/stderr"
                exit 1
            }
            main = 1
            for (i = 1; i <= n; i++) if (prim[i]) { main = i; break }
            left = 0
            for (i = 1; i <= n; i++)
                if (i != main && xs[i] < xs[main] && (!left || xs[i] < xs[left])) left = i
            extra = 0
            for (i = 1; i <= n; i++)
                if (i != main && i != left && (!extra || xs[i] < xs[extra])) extra = i
            printf "MONITOR_MAIN=%s\n", names[main]
            if (left)  printf "MONITOR_LEFT=%s\n", names[left]
            if (extra) printf "MONITOR_EXTRA=%s\n", names[extra]
            for (i = 1; i <= n; i++)
                if (i != main && i != left && i != extra)
                    printf "monitor-roles: no role for %s (only MAIN/LEFT/EXTRA exist)\n", names[i] > "/dev/stderr"
        }
    '
}

merge_env() {
    awk '
        /^MONITOR_(MAIN|LEFT|EXTRA|SPLIT_TOP|SPLIT_BOTTOM)=[A-Za-z0-9._~-]*$/ { print; next }
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*$/ { next }
        { print "monitor-roles: merge-env ignoring line: " $0 > "/dev/stderr" }
    ' "$1"
}

case "${1-}" in
    "") xrandr --listactivemonitors | assign ;;
    assign) assign ;;
    merge-env)
        [ $# -eq 2 ] || usage
        [ -r "$2" ] || { echo "monitor-roles: cannot read $2" >&2; exit 1; }
        merge_env "$2"
        ;;
    *) usage ;;
esac
