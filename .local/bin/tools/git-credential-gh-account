#!/usr/bin/env bash
# git-credential-gh-account - a git credential helper that answers with the
# token of the GitHub account git asks for, so one machine pushes as a
# different gh account per remote. gh's own helper (`gh auth git-credential`)
# answers only for gh's active account.
#
# git sends username= when credential.<url>.username is set. ~/.gitconfig
# includes ~/.gitconfig-personal or ~/.gitconfig-work by remote URL, and each
# sets it. For that account this helper prints the token gh holds (`gh auth
# token --user`). Without a username, or for an account gh is not logged in
# to, it prints nothing and git asks the next helper. It answers only `get`:
# gh keeps the tokens, so `store` and `erase` do nothing.
#
# .gitconfig-os##os.Darwin lists it ahead of gh's helper for github.com and
# gist.github.com.
set -euo pipefail

[[ ${1:-} == get ]] || exit 0

protocol='' host='' username=''
while IFS= read -r line && [[ -n $line ]]; do
    case $line in
        protocol=*) protocol=${line#protocol=} ;;
        host=*) host=${line#host=} ;;
        username=*) username=${line#username=} ;;
    esac
done
[[ $protocol == https && -n $host && -n $username ]] || exit 0

# gh files gist.github.com's token under github.com.
[[ $host != gist.github.com ]] || host=github.com
gh=$(command -v gh || printf '%s\n' /opt/homebrew/bin/gh)
token=$("$gh" auth token --hostname "$host" --user "$username" 2>/dev/null) || exit 0
[[ -n $token ]] || exit 0
printf 'username=%s\npassword=%s\n' "$username" "$token"
