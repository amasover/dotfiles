#!/usr/bin/env bash
# metapac-drift-report — read-only package-drift summary (Story 2.9).
#
# Three sections, then the copy-paste follow-up:
#   1. unmanaged            — installed explicitly but declared nowhere
#                             (raw `pacman -S` backstop; yay installs are inbox-captured)
#   2. declared-but-missing — in a group but not installed (fresh-machine gap / removal drift)
#   3. inbox triage         — auto-captured packages awaiting a real purpose group
#
# Run standalone anytime, or via `setup/update` (end of run). Never mutates:
# `metapac sync`/`clean` stay manual, prompted commands (see
# docs/decision-bootstrap-architecture.md — drift loop).
# shellcheck disable=SC2001  # `sed 's/^/     /'` is this file's indent idiom
set -euo pipefail

groups_dir="$HOME/.config/metapac/groups"
config="$HOME/.config/metapac/config.toml"
tools_dir=${METAPAC_TOOLS_DIR:-$HOME/.local/bin/tools}

if [[ ! -d "$groups_dir" || ! -f "$config" ]]; then
    echo "metapac-drift-report: no metapac config on this machine — skipping."
    exit 0
fi

# One hostname-aware resolver owns both active group paths and package names.
active_group_files=$("$tools_dir/metapac-declared" --group-files) || {
    echo "metapac-drift-report: could not resolve active group files" >&2
    exit 1
}
declared=$("$tools_dir/metapac-declared") || {
    echo "metapac-drift-report: could not resolve active declared packages" >&2
    exit 1
}

echo
echo "=============================================================="
echo " metapac drift report ($(date +%F\ %H:%M)) — read-only"
echo "=============================================================="

# 1. unmanaged — metapac itself is the authority here, minus vendored
# packages (Story 2.46): those are built from .config/dotfiles/pkgbuilds/ and
# deliberately never declared (metapac would resolve the name to the AUR).
unmanaged=$(metapac unmanaged 2>/dev/null || true)
un_names=""
if [[ -n "$unmanaged" ]]; then
    # Both metapac output shapes (0.10 inline TOML + legacy) — Story 2.42, #135.
    un_names=$(echo "$unmanaged" | "$tools_dir/metapac-unmanaged-names")
fi
vendored=$("$tools_dir/custom-pkgs" list 2>/dev/null || true)
un_vendored=$(comm -12 <(sort <<<"$un_names") <(sort <<<"$vendored") | sed '/^$/d')
un_real=$(comm -23 <(sort <<<"$un_names") <(sort <<<"$vendored") | sed '/^$/d')
if [[ -n "$un_real" ]]; then
    echo
    echo " [!] unmanaged (installed, declared nowhere — likely raw pacman -S):"
    sed 's/^/     /' <<<"$un_real"
    echo "     fix: declare in a purpose group, park in the inbox, or uninstall"
else
    echo
    echo " [ok] unmanaged: none"
fi
if [[ -n "$un_vendored" ]]; then
    echo " [ok] vendored (built from .config/dotfiles/pkgbuilds — expected):"
    sed 's/^/     /' <<<"$un_vendored"
fi

# 2. declared-but-missing — declared in some group, not installed at all.
# Known-broken and age-deferred names (Story 2.38) split into their own
# sections below, so `missing` stays surprising enough to stay useful.
kb_rows=$("$tools_dir/aur-quarantine" broken-list 2>/dev/null || true)
def_file="${XDG_STATE_HOME:-$HOME/.local/state}/aur-quarantine/deferred.tsv"
held_names=$({
    cut -f1 <<<"$kb_rows"
    cut -f1 "$def_file" 2>/dev/null
    true
} | sed '/^$/d' | sort -u)

missing_all=$(comm -13 <(pacman -Qq | sort) <(printf '%s\n' "$declared") | sed '/^$/d' || true)
missing=$(comm -23 <(printf '%s\n' "$missing_all") <(printf '%s\n' "$held_names") | sed '/^$/d' || true)
if [[ -n "$missing" ]]; then
    echo
    echo " [!] declared but not installed:"
    sed 's/^/     /' <<<"$missing"
    echo "     apply:  metapac sync   (prompts before acting)"
else
    echo " [ok] declared-but-missing: none"
fi

# 2b. known-broken — human-recorded unbuildable packages (runs skip them while
# the AUR commit is unmoved). Showing `since` keeps entry age visible: stale
# entries are a person's job to retire, by design (no time-based retry).
if [[ -n "$kb_rows" ]]; then
    echo
    echo " [!] known-broken (runs skip these; auto-retried when upstream moves):"
    while IFS=$'\t' read -r kp _ kat ksince kreason; do
        [[ -n "$kp" ]] || continue
        printf '     %s — since %s (at %.8s): %s\n' "$kp" "${ksince:-?}" "${kat:-?}" "${kreason:-no reason recorded}"
    done <<<"$kb_rows"
    echo "     builds again?  aur-quarantine unbroken <pkg>   — force one attempt: bootstrap --unattended --retry-broken"
fi

# 2c. age-deferred — the last unattended run's wait-holds; converge by
# themselves once a version ages past the quarantine window.
if [[ -s "$def_file" ]] && grep -q $'\tage\t' "$def_file"; then
    echo
    echo " [i] age-deferred (as of the last unattended run, $(date -r "$def_file" +'%F %H:%M')):"
    while IFS=$'\t' read -r dp dc dw; do
        [[ "$dc" == age ]] || continue
        printf '     %s — %s\n' "$dp" "$dw"
    done <"$def_file"
fi

# 3. Inbox triage reads the single inbox in this host's resolved group files.
inboxes=()
while IFS= read -r file; do
    name=${file##*/}
    [[ $name == inbox-*.toml ]] && inboxes+=("$file")
done <<<"$active_group_files"
if ((${#inboxes[@]} == 1)); then
    inbox=${inboxes[0]}
    if [[ ! -f $inbox ]]; then
        echo " [!] inbox: active file missing: ${inbox##*/}"
    else
        inboxed=$(sed -n 's/^[[:space:]]*"\([^"]*\)".*/\1/p' "$inbox")
        if [[ -n $inboxed ]]; then
            n=$(wc -l <<<"$inboxed")
            echo
            echo " [!] inbox: $n package(s) awaiting triage in ${inbox##*/}:"
            sed 's/^/     /' <<<"$inboxed"
            echo "     triage: edit ${inbox/#$HOME/\~}"
            echo "             move each entry to a purpose group (or delete it, then"
            echo "             'metapac clean' proposes the uninstall)"
        else
            echo " [ok] inbox: empty"
        fi
    fi
else
    echo " [!] inbox: expected one active rendered inbox, found ${#inboxes[@]}"
fi
