#!/usr/bin/env bash
# metapac-declared — resolve this host's active groups and declared packages.
#
# metapac has no list command, so this parses the rendered config the same way
# metapac reads it: this hostname's [hostname_groups] entry -> group files ->
# quoted names inside each file's `[arch]` package array. Default output is the
# sorted package set. `--group-files` exposes the resolved active file paths so
# inbox capture, drift reporting, removal capture, and harness checks share one
# hostname-aware resolver instead of maintaining divergent parsers.
#
# Package output may include never-publish machine-local names — do not paste it
# into tracked files, issues, or transcripts (Story 2.11).
#
# Flags: --config-dir DIR   (default: ~/.config/metapac)
#        --hostname NAME    (default: uname -n)
#        --group-files      print active group paths instead of package names
set -euo pipefail

cfg_dir="$HOME/.config/metapac"
host="$(uname -n)"
mode=packages
while (($#)); do
    case "$1" in
        --config-dir)
            cfg_dir=$2
            shift 2
            ;;
        --hostname)
            host=$2
            shift 2
            ;;
        --group-files)
            mode=group-files
            shift
            ;;
        *)
            echo "usage: metapac-declared [--config-dir DIR] [--hostname NAME] [--group-files]" >&2
            exit 2
            ;;
    esac
done
cfg="$cfg_dir/config.toml"
[[ -f "$cfg" ]] || {
    echo "metapac-declared: no config at $cfg (yadm alt not run?)" >&2
    exit 1
}

# entries of this host's group array: from the "<host>" = [ line to the first ]
mapfile -t entries < <(awk -v h="\"$host\" = [" '
    { line = $0; sub(/[[:space:]]*#.*/, "", line) }
    index(line, h) { grab = 1; next }
    grab && line ~ /\]/ { exit }
    grab && match(line, /"([^"]*)"/, m) { print m[1] }' "$cfg")
((${#entries[@]})) || {
    echo "metapac-declared: no [hostname_groups] entry for '$host' in $cfg" >&2
    exit 1
}

group_files=()
for e in "${entries[@]}"; do
    if [[ "$e" == /* ]]; then
        f=$e
        if [[ ! -f $f && $f != *.toml && -f $f.toml ]]; then f+=.toml; fi
    else
        f="$cfg_dir/groups/$e"
        [[ $f == *.toml ]] || f+=.toml
    fi
    [[ -f "$f" ]] || {
        echo "metapac-declared: missing group file $f" >&2
        exit 1
    }
    group_files+=("$f")
done

if [[ $mode == group-files ]]; then
    printf '%s\n' "${group_files[@]}"
    exit 0
fi

for f in "${group_files[@]}"; do
    awk '{ line = $0; sub(/[[:space:]]*#.*/, "", line) }
         line ~ /^\[arch\]/ { a = 1; next }
         line ~ /^\[/       { a = 0 }
         a && match(line, /"([^"]*)"/, m) { print m[1] }' "$f"
done | sort -u
