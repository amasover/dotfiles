#!/usr/bin/env bash
# Start OMP with provider-paired primary, review, and mechanical-worker models.
set -euo pipefail

case "${1:-}" in
    claude | copilot | openai | openrouter)
        mode=$1
        shift
        ;;
    -h | --help | "")
        cat <<'EOF'
Usage: omp-mode <claude|copilot|openai|openrouter> [omp arguments...]

  claude      Opus 5.5 xhigh primary; Opus 5.5 medium reviews and tasks;
              Haiku low mechanical subagents
  copilot     Sol max primary; Sol high reviews;
              Luna max tasks; Luna xhigh mechanical subagents
  openai      Astra xhigh primary; Sol high reviews;
              Luna max tasks; Luna high mechanical subagents
  openrouter  Gemini 3.8 Flash high primary; DeepSeek V4 Pro 0813 max reviews;
              GLM 5.3 Flash max tasks; GLM 5.3 Flash low mechanical subagents
EOF
        exit 0
        ;;
    *)
        echo "omp-mode: unknown mode: $1 (try: omp-mode --help)" >&2
        exit 2
        ;;
esac

mode_config="$HOME/.omp/agent/modes/$mode.yml"
# PI_CONFIG_FILES applies to every OMP command, including `omp config`, unlike
# the root --config flag. Put the selected mode last: primary, review, and cheap
# worker models must stay provider-paired even when a caller has another overlay.
export PI_CONFIG_FILES="${PI_CONFIG_FILES:+$PI_CONFIG_FILES:}$mode_config"

# Resolve omp by path, not PATH: the shell puts ~/.local/bin/{setup,tools,work},
# ~/.bin and ~/.local/bin ahead of /usr/bin, so a stale omp or a wrapper that
# calls omp-mode could run instead, or loop. pacman installs /usr/bin/omp; the
# macOS installer, ~/.local/bin/omp. OMP_MODE_CANDIDATES (a :-list) is the test
# seam. A candidate that is this script, by link or by copy, never counts.
self=$(realpath "$0")
omp=
IFS=: read -r -a candidates <<<"${OMP_MODE_CANDIDATES:-/usr/bin/omp:$HOME/.local/bin/omp}"
for candidate in "${candidates[@]}"; do
    [[ -f $candidate && -x $candidate ]] || continue
    [[ $(realpath "$candidate") != "$self" ]] || continue
    cmp -s "$candidate" "$self" && continue
    omp=$candidate
    break
done
if [[ -z $omp ]]; then
    echo "omp-mode: no omp binary at ${OMP_MODE_CANDIDATES:-/usr/bin/omp or $HOME/.local/bin/omp}" >&2
    exit 1
fi
exec "$omp" "$@"
