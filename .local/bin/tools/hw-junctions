#!/usr/bin/env bash
# hw-junctions — powerline junction colors for self-gating bar segments
# (Story 3.23, #179).
#
# temperature/battery keep their historical mid-chain spot (volume → temp →
# battery → time) and polybar's own hardware detection drops each where the
# hardware doesn't exist. A powerline chevron's background must match the
# PREVIOUS VISIBLE segment's background, and with mid-chain segments that's
# only knowable at launch: exactly two junctions depend on it — battery's
# entry chevron (after temp, or after volume) and the time chevron (after
# battery, temp, or volume). launch.sh runs `hw-junctions emit` into
# ~/.cache/polybar/hw-junctions, which the nord-arrow body splices into its
# [hw] section; the two dynamic keys are referenced as ${hw.bat-prev} /
# ${hw.time-prev}. Everything else in the chain stays static.
#
# Probes (same facts polybar's modules use): temp = a thermal_zone exists,
# battery = a BAT* power supply exists.
#
# Usage:
#   hw-junctions emit [SYSROOT]   the include-file content on stdout
#                                 (SYSROOT defaults to /sys; tests inject a
#                                 fixture). Bare keys — the including section
#                                 provides the [hw] header.
set -euo pipefail

# nord palette, matching themes/nord/colors (inline hexes: polybar resolves
# ${colors.x} references only as whole values, so generated keys carry hex)
nord7='#8FBCBB'  # volume-tail bg
nord8='#88C0D0'  # temperature bg
nord9='#81A1C1'  # battery bg

cmd_emit() {
    local sys="${1:-/sys}" temp=0 bat=0 bat_prev time_prev
    compgen -G "$sys/class/thermal/thermal_zone*" >/dev/null && temp=1
    compgen -G "$sys/class/power_supply/BAT*" >/dev/null && bat=1
    if ((temp)); then bat_prev=$nord8; else bat_prev=$nord7; fi
    if ((bat)); then time_prev=$nord9; elif ((temp)); then time_prev=$nord8; else time_prev=$nord7; fi
    printf '; generated by launch.sh via tools/hw-junctions — do not edit (3.23)\n'
    printf 'bat-prev = %s\n' "$bat_prev"
    printf 'time-prev = %s\n' "$time_prev"
}

case "${1:-}" in
emit) cmd_emit "${2:-}" ;;
-h | --help) sed -n '2,/^set -euo/{/^set -euo/d; s/^# \{0,1\}//p;}' "$0" ;;
*) echo "hw-junctions: unknown subcommand: ${1:-<none>}   (try: hw-junctions -h)" >&2; exit 1 ;;
esac
