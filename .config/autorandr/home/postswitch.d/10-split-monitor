#!/bin/sh
# Build the home split before global postswitch relaunches Polybar: the tracked
# layout (~/.config/monitor-split/home.layout) across the two 1920x2160
# picture-by-picture inputs — DP-1-2 stays whole as main, DP-1-1 is carved
# into DP-1-1~1 (top) and DP-1-1~2 (bottom) — plus its i3 workspace map.
set -eu

"$HOME/.local/bin/tools/monitor-split" apply home DP-1-2 DP-1-1 >/dev/null
