; Shared bar baseline (#166): every theme includes this file and its
; [bar/base] does `inherit = bar/global`, overriding freely — inherit gives
; per-key override semantics, unlike include-file merging, where defining
; the same key twice is a FATAL parse error.
[bar/global]
; The laptop's historical look (pre-5.5 untracked config.ini): big arrows
; from an arrows-only font first in the list, text from Hack, icons from
; FontAwesome. Order is load-bearing — polybar serves each glyph from the
; FIRST font that has it, and Powerline Extra Symbols contains ONLY the
; powerline glyphs, so nothing else is hijacked by its size 19.
; Portability: Powerline Extra Symbols is an untracked ~/.fonts copy on the
; laptop (vendoring it 2.47-style is the open follow-up); machines without
; it fall through to Hack (ttf-hack), which ships the powerline glyphs
; natively — arrows render smaller but never drop. FontAwesome comes from
; awesome-terminal-fonts; both packages declared in desktop.toml.
; (module/vpn's format-font = 2 targets font-1 = Hack, as it always did.)
font-0 = Powerline Extra Symbols:size=19;4
font-1 = Hack:pixelsize=12;3
font-2 = FontAwesome:size=12;3
; polybar-msg (theme selector, polybar-reload) needs ipc
enable-ipc = true
; keeps bars out of i3 stacking fights
wm-restack = i3
cursor-click = pointer
cursor-scroll = ns-resize

; vim:ft=dosini
