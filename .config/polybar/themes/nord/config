# Shared across themes — under the 5.5 launcher the theme file IS the whole
# config, so it pulls in the module library (updates-arch etc.) and the
# bar/global baseline (fonts, ipc, wm-restack, cursors) itself.
include-file = $HOME/.config/polybar/themes/global/base
include-file = $HOME/.config/polybar/themes/global/modules

[colors]
include-file = $HOME/.config/polybar/themes/nord/colors

# every bar inherits these; the section was lost in the pre-themes-dir
# capture (bars said `inherit = bar/base` but no such section existed —
# fatal once anything actually parses this config with -c)
[bar/base]
inherit = bar/global
background = ${colors.nord0}
foreground = ${colors.nord4}

[bar/main-top-middle]
; require monitor to be connected to load bar
monitor-strict = true
inherit = bar/base
monitor = ${env:MONITOR_MAIN}
modules-right = 
modules-left = 
modules-center = i3
background = ${colors.secondary-bg}
width = 25%
bottom = false 
tray-position = none
height = 3%
padding = 0
override-redirect = true
offset-x = 37.5%
offset-y = 20
border-size = 4
border-color = ${colors.nord2}
wm-name=chicken

[bar/main-top-right]
; require monitor to be connected to load bar
monitor-strict = true
inherit = bar/base
monitor = ${env:MONITOR_MAIN}
modules-right = audio-switch volume-tail time calendar
modules-left = 
modules-center =
border = 2
background = ${colors.secondary-fg}
width = 365
bottom = false 
tray-position = none
height = 3%
padding = 0
override-redirect = true
offset-x = 84.5%
offset-y = 20
border-size = 4
border-color = ${colors.nord2}

[bar/main-top-left]
; require monitor to be connected to load bar
monitor-strict = true
inherit = bar/base
monitor = ${env:MONITOR_MAIN}
modules-right = 
; module name fixed: the section in global/modules is yadm-checker-dot-sh
modules-left = yadm-checker-dot-sh updates-arch
modules-center = 
border = 2
width = 13.5%
background = ${colors.nord10}
bottom = false 
tray-position = none
height = 3%
padding = 0
override-redirect = true
offset-x = 30
offset-y = 20
border-size = 4
border-color = ${colors.nord2}


[bar/left-top-middle]
; require monitor to be connected to load bar
monitor-strict = true
inherit = bar/base
monitor = ${env:MONITOR_LEFT}
modules-right = 
modules-left = 
modules-center = i3
border = 2
background = ${colors.secondary-bg}
width = 25%
bottom = false 
tray-position = none
height = 3%
padding = 0
override-redirect = true
offset-x = 37.5%
offset-y = 20
border-size = 4
border-color = ${colors.nord2}

[bar/right-top-middle]
; require monitor to be connected to load bar
monitor-strict = true
inherit = bar/base
monitor = ${env:MONITOR_RIGHT}
modules-right = 
modules-left = 
modules-center = i3
border = 2
background = ${colors.secondary-bg}
width = 25%
bottom = false 
tray-position = none
height = 3%
padding = 0
override-redirect = true
offset-x = 37.5%
offset-y = 20
border-size = 4
border-color = ${colors.nord2}


[module/i3]
pin-workspaces = true
type = internal/i3
enable-click = true
enable-scroll = false
wrapping-scroll = false
reverse-scroll = false
fuzzy-match = true
format = <label-mode><label-state>
label-mode = %mode%
label-focused-foreground = ${colors.primary-fg}
label-focused-background = ${colors.primary-bg}
label-focused-padding-right = 2
label-focused-padding-left = 1
; visible is the focused workspace on non focused monitor, confusing, i know. :)
label-visible-background=${colors.primary-bg}
label-visible-foreground=${colors.primary-fg}
label-visible-padding-right = 2
label-visible-padding-left = 1
label-unfocused-foreground = ${colors.secondary-fg}
label-unfocused-background = ${colors.secondary-bg}
label-unfocused-padding-right = 2
label-unfocused-padding-left = 1
label-urgent-foreground = ${colors.urgent-fg}
label-urgent-background = ${colors.urgent-bg}
label-urgent-padding = 1

[module/calendar]
type = internal/date
interval = 5
date = %m/%d/%Y
date-alt = " %Y-%m-%d"
format-background = ${colors.primary-bg}
format-foreground = ${colors.primary-fg}
label = "   %date%  "

[module/time]
type = internal/date
interval = 5
time = %I:%M %p
format-foreground = ${colors.secondary-fg}
format-background = ${colors.secondary-bg}
label = "   %time%  "

[module/audio-switch]
type = custom/script
click-left = ~/.local/bin/tools/audio-switch switch
exec = ~/.local/bin/tools/audio-switch listen --mutefg BF616A --mutebg 81A1C1 --bg 81A1C1 --fg 3B4252 --padleft " "
tail = true

[module/volume-tail]
type = custom/script
exec = ~/.local/bin/tools/volume-tail --padright " "
tail = true
click-right = exec pavucontrol &
click-left = ~/.local/bin/tools/volume-tail --mute
scroll-up = ~/.local/bin/tools/volume-tail --up 3
scroll-down = ~/.local/bin/tools/volume-tail --down 3
format-padding = 1


; formatting
; vim:ft=dosini
