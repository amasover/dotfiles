# gpg-agent on the Mac (class work-mac). yadm links this file to
# ~/.gnupg/gpg-agent.conf on Darwin only. mise bootstrap installs pinentry-mac
# (.config/mise/config.toml##os.Darwin). The agent reads this file only when it
# starts, so the yadm bootstrap stops it before it decrypts.
#
# Passphrases are asked in a macOS dialog. The default terminal prompt,
# pinentry-curses, failed in Ghostty with "Screen or window too small": its
# terminal type, xterm-ghostty, is found only through Ghostty's TERMINFO, which
# gpg-agent does not pass on. The dialog needs no terminal, so it also works
# from shells that have none, such as an agent's.
pinentry-program /opt/homebrew/opt/pinentry-mac/bin/pinentry-mac

# Hide pinentry-mac's "Save in Keychain" box: passphrases stay out of the login
# keychain, and only gpg-agent's own short-lived cache keeps them.
no-allow-external-cache
